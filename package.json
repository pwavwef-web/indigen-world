{
  "name": "indigen-world",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the Indigen World cultural-technology ecosystem.",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/design-tokens",
    "packages/web-ui",
    "apps/website",
    "apps/admin",
    "apps/tribestudio",
    "apps/team-websites/francis-pwavwe",
    "firebase/tests",
    "services/functions"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run test:contracts && npm run test:rules && npm run test:storage-rules && npm run test:e2e",
    "seed": "firebase emulators:exec --project demo-indigen-world --only firestore \"node firebase/seed/seed.mjs\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "build:web-ui": "npm run build --workspace @indigen-world/web-ui",
    "build:website": "npm run build --workspace @indigen-world/website",
    "build:admin": "npm run build --workspace @indigen-world/admin",
    "build:tribestudio": "npm run build --workspace @indigen-world/tribestudio",
    "build:team-francis-pwavwe": "npm run build --workspace @indigen-world/team-francis-pwavwe",
    "build:functions": "npm run build --workspace @indigen-world/functions",
    "typecheck:website": "npm run typecheck --workspace @indigen-world/website",
    "typecheck:admin": "npm run typecheck --workspace @indigen-world/admin",
    "typecheck:tribestudio": "npm run typecheck --workspace @indigen-world/tribestudio",
    "typecheck:team-francis-pwavwe": "npm run typecheck --workspace @indigen-world/team-francis-pwavwe",
    "test:contracts": "npm test --workspace @indigen-world/contracts",
    "test:rules": "firebase emulators:exec --project demo-indigen-world --only firestore \"node --test firebase/tests/firestore.rules.test.mjs firebase/tests/creator.rules.test.mjs\"",
    "test:storage-rules": "firebase emulators:exec --project demo-indigen-world --only auth,storage \"node --test firebase/tests/storage.rules.test.mjs\"",
    "test:e2e": "npm run build:functions && cross-env FUNCTIONS_DISCOVERY_TIMEOUT=120 firebase emulators:exec --project demo-indigen-world --only auth,firestore,functions \"node --test firebase/tests/decideReview.test.mjs firebase/tests/creatorFunctions.test.mjs firebase/tests/publicForms.test.mjs\""
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "firebase-tools": "15.19.1"
  }
}
