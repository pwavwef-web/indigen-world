# Local emulator mode does not require App Check.
VITE_USE_EMULATORS=false

# reCAPTCHA Enterprise site key for Firebase App Check (a public site identifier).
# The production public key is checked into app-check.config.json. An override
# must be registered for this Firebase app and permitted for the deployed domain.
# Admin callables enforce App Check independently of ENFORCE_APP_CHECK.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
