{
  "name": "@indigen-world/website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node ./scripts/prerender-meta.mjs && node ./scripts/emit-well-known.mjs && node ./scripts/emit-app-ads.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "node ./scripts/validate-site.mjs",
    "test:motion": "node ./scripts/check-motion.mjs",
    "test:runner": "node --experimental-strip-types --test ./scripts/runner-engine.test.mjs && node ./scripts/check-runner.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@remotion/player": "4.0.532",
    "firebase": "^11.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
