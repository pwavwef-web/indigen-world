# Canonical production origin (no trailing slash)
VITE_SITE_URL=https://indigenworld.com

# The single authorised-seller record AdMob supplies for this account, copied
# exactly. Set it in the deployment environment only: the publisher id it
# contains must not be committed. The build emits dist/app-ads.txt when it is
# present and skips the file, with a warning, when it is not.
# Shape: google.com, pub-<16 digits>, DIRECT, f08c47fec0942fa0
ADMOB_APP_ADS_TXT_RECORD=

# Optional override; Firebase Hosting uses /api/public-forms by default
VITE_PUBLIC_FORMS_ENDPOINT=

# Analytics is opt-in at build time and requires the Firebase values below
VITE_ANALYTICS_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
