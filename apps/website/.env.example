# Canonical production origin (no trailing slash)
VITE_SITE_URL=https://indigen-world.web.app

# Reviewed, rate-limited Firebase HTTPS Function for public forms
VITE_PUBLIC_FORMS_ENDPOINT=

# Analytics is opt-in at build time and requires the Firebase values below
VITE_ANALYTICS_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
