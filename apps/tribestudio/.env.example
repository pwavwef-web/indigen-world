# Local emulator mode does not require App Check.
VITE_USE_EMULATORS=false

# reCAPTCHA Enterprise site key for Firebase App Check (a public site identifier).
# Production defaults to the registered public key in app-check.config.json.
# Staff callables always require App Check; shared contributor callables retain
# their existing ENFORCE_APP_CHECK deployment policy. This is an optional override.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=replace-with-public-site-key
