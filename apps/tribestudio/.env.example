# Local emulator mode does not require App Check.
VITE_USE_EMULATORS=false

# reCAPTCHA Enterprise site key for Firebase App Check (a public site identifier).
# Set this for deployed builds. Callable Functions only enforce App Check when
# they are deployed with ENFORCE_APP_CHECK=true — enable both together in staging
# and production so the App Check tokens this app sends are actually verified.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=replace-with-public-site-key
