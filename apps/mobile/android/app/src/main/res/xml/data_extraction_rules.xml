<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android 12+ form of backup_rules.xml, which carries the full commentary.
  Same single include, said twice, because from Android 12 the two ways data
  leaves a device are configured separately:

    <cloud-backup>    the encrypted Google backup a new phone restores from.
    <device-transfer> the cable copy during device-to-device setup.

  Both matter for Zero-Tap Sign-In — a member may set up their next handset
  either way, and the restore key travels by whichever route they choose — so
  both are configured identically rather than one being left to a default.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </device-transfer>
</data-extraction-rules>
