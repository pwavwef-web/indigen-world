<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon, Android 8+.

     The three layers are deliberately separate files. A launcher masks this
     canvas to its own shape and may translate it for parallax, so the
     background is drawn full bleed (it is meant to be cropped) while the
     foreground carries only the house, bars and sun, well inside the safe
     zone. The monochrome layer is what Android 13+ themed icons tint.

     All three are generated by tool/generate_app_icons.py — edit the geometry
     there and re-run it rather than touching the PNGs by hand. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
