<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar icon for every Indigen World alert.

  Android silhouettes notification icons: only the alpha channel survives, and
  anything with colour or detail arrives as a white blob. The launcher icon is
  therefore unusable here, which is why this exists separately — a flat,
  single-path rendering of the four-pointed brand motif (the same "✣" the
  launch screen builds its emblem from).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,1.6 Q13.7,8.3 22.4,12 Q13.7,15.7 12,22.4 Q10.3,15.7 1.6,12 Q10.3,8.3 12,1.6 Z"/>
</vector>
