<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Core flows (Firebase, cached network images) require network access in
         every build type. Declared here so release builds do not depend on
         library manifest-merge for INTERNET. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- connectivity_plus reads the active network to decide whether an action
         can reach Indigen World; without this the plugin reports "none" on some
         OEM builds and the app looks permanently offline. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Android 13+ requires an explicit runtime grant before any notification
         can be posted. Requested from the notifications centre. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Voice notes in Community use the microphone only while the member is
         visibly recording from the composer. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- The three the music player needs, and only the music player.

         A song keeps playing with the screen off, which is the whole point of
         a player rather than a preview button; without WAKE_LOCK the CPU is
         allowed to sleep between buffers and playback stutters and then dies.
         FOREGROUND_SERVICE and its mediaPlayback type are what let the
         playback service keep running once the app is no longer on screen —
         from Android 14 an untyped foreground service is refused outright, so
         the pair has to be declared together or the first song crashes the
         process the moment somebody goes to their home screen. Nothing else in
         the app runs a service, which is why these arrive with the player. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Lets a tapped push wake the app with its payload attached, which
                 is what FirebaseMessaging.onMessageOpenedApp reads. -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- ── The music playback service ───────────────────────────────────
             Everything below belongs to audio_service. The service is the
             process that outlives the Activity: it holds the media session
             Android draws the lock-screen and notification controls from, and
             it is what keeps a song playing after the app is swiped away.

             `exported="true"` is not a choice. A MediaBrowserService is bound
             by other processes — Android Auto, Assistant, Wear, the system
             media resumption row that offers to restart what you were last
             listening to — and an unexported service is invisible to all of
             them.

             `tools:ignore="Instantiatable"` silences a lint that is simply
             wrong here: the class lives in the audio_service AAR rather than
             in this module's sources, so Lint cannot see a constructor and
             reports the service as un-instantiatable. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>
        <!-- Headset buttons and Bluetooth steering-wheel controls arrive as a
             broadcast, not as a touch. Without this receiver a squeeze of the
             earbud does nothing at all, and on some OEM builds the broadcast is
             instead handed to whatever other app last claimed it. -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Community alerts land in their own channel so a member can mute
             them from system settings without losing everything else. Must
             match the channel id the fan-out function sends, and the channel
             the app creates at start-up (notification_channels.dart).

             The `_v2` suffix is load-bearing. No build before this one created
             the channel itself, so on any handset that had already received an
             alert Android auto-created `indigen_community` at *default*
             importance — silent, no heads-up — and a channel's importance
             cannot be raised after it exists. A new id is the only way to give
             those devices the channel they should have had. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="indigen_community_v2"/>
        <!-- Without these a backgrounded push draws the launcher icon, which
             Android silhouettes into a white square. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
