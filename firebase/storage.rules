rules_version = '2';

// Indigen World Storage Security Rules.
//
// Raw creator submission media is PRIVATE: only the owner and staff (validators/
// admins) may read it, and it never becomes public on upload. Approved public
// media is served from a separate, world-readable path that only trusted
// server-side code (Admin SDK, which bypasses these rules) may write.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return isSignedIn() ? request.auth.token.get('role', null) : null;
    }
    function isStaff() {
      return role() == 'validator'
        || role() == 'reviewer'
        || role() == 'admin'
        || role() == 'super_admin'
        || (isSignedIn() && request.auth.token.get('superAdmin', false) == true);
    }
    function isBlockedCreator() {
      return isSignedIn() && request.auth.token.get('creatorStatus', '') in ['suspended', 'revoked', 'rejected'];
    }
    // 500 MB ceiling; per-campaign limits are enforced additionally server-side.
    function withinSizeLimit() {
      return request.resource.size < 500 * 1024 * 1024;
    }
    function allowedType() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('audio/.*')
        || request.resource.contentType.matches('video/.*')
        || request.resource.contentType == 'application/pdf';
    }

    // ---- Raw creator submissions: private, owner-writable -------------------
    // creator-submissions/{uid}/{campaignId}/{submissionId}/{fileName}
    //
    // Any signed-in account that is not suspended may upload into its OWN
    // prefix, because publishing to Explore no longer requires verification.
    // The approval gate that used to live here now sits where it belongs — on
    // campaign submissions in firestore.rules — and this path stays private to
    // its owner and staff regardless, so opening it exposes nothing: a file
    // only becomes world-readable when the publication workflow copies it into
    // published-media/, which no client can write.
    match /creator-submissions/{uid}/{campaignId}/{submissionId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && !isBlockedCreator()
        && withinSizeLimit()
        && allowedType();
      allow delete: if isSignedIn() && ((request.auth.uid == uid && !isBlockedCreator()) || isStaff());
    }

    // ---- Creator profile avatars: owner-writable, world-readable ------------
    match /creator-avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && !isBlockedCreator()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && request.auth.uid == uid && !isBlockedCreator();
    }

    // ---- Approved public media: world-readable, server-written only ---------
    // Populated by the publication workflow from approved submissions.
    match /published-media/{contentId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Community feed media: world-readable, owner-writable --------------
    // Photos and short videos attached to community posts. Public because the
    // feed itself is public; writes are limited to the poster's own prefix so
    // one member can never overwrite another's media.
    function communityImageOk() {
      return request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    function communityPostMediaOk() {
      return (request.resource.contentType.matches('image/.*')
          && request.resource.size < 12 * 1024 * 1024)
        || (request.resource.contentType.matches('video/.*')
          && request.resource.size < 128 * 1024 * 1024);
    }

    match /community-media/{uid}/{postId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && communityPostMediaOk();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isStaff());
    }

    match /community-avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && communityImageOk();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isStaff());
    }

    match /community-banners/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && communityImageOk();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isStaff());
    }

    // ---- Default deny -------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
