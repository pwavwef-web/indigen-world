rules_version = '2';

// Indigen World Storage Security Rules.
//
// Raw creator submission media is PRIVATE: only the owner and staff (validators/
// admins) may read it, and it never becomes public on upload. Approved public
// media is served from a separate, world-readable path that only trusted
// server-side code (Admin SDK, which bypasses these rules) may write.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return isSignedIn() ? request.auth.token.get('role', null) : null;
    }
    function isStaff() {
      return role() == 'validator'
        || role() == 'reviewer'
        || role() == 'admin'
        || role() == 'super_admin'
        || (isSignedIn() && request.auth.token.get('superAdmin', false) == true);
    }
    // Narrower than isStaff(): a validator or reviewer decides what community
    // work is published, which is not the same authority as writing the app's
    // own teaching material or its advertising.
    function isAdmin() {
      return role() == 'admin'
        || role() == 'super_admin'
        || (isSignedIn() && request.auth.token.get('superAdmin', false) == true);
    }
    function isBlockedCreator() {
      return isSignedIn() && request.auth.token.get('creatorStatus', '') in ['suspended', 'revoked', 'rejected'];
    }
    // 500 MB ceiling; per-campaign limits are enforced additionally server-side.
    function withinSizeLimit() {
      return request.resource.size < 500 * 1024 * 1024;
    }
    // Documents joined images, audio and video when Literature contributions
    // started arriving as manuscripts rather than pasted text. The list is
    // explicit rather than a wildcard on application/*: that prefix also
    // covers executables and archives, which have no business in a raw
    // submission prefix a reviewer will open.
    function allowedDocumentType() {
      return request.resource.contentType in [
        'application/pdf',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/rtf',
        'application/epub+zip',
        'text/plain',
        'text/markdown'
      ];
    }
    function allowedType() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('audio/.*')
        || request.resource.contentType.matches('video/.*')
        || allowedDocumentType();
    }

    // ---- Raw creator submissions: private, owner-writable -------------------
    match /grammarAudio/{uid}/{fileName} {
      // Reviewers use readGrammarAudio so withdrawal and revision are checked.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && !isBlockedCreator()
        && resource == null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if isSignedIn() && request.auth.uid == uid;
      allow update: if false;
    }

    // creator-submissions/{uid}/{campaignId}/{submissionId}/{fileName}
    //
    // Any signed-in account that is not suspended may upload into its OWN
    // prefix, because publishing to Explore no longer requires verification.
    // The approval gate that used to live here now sits where it belongs — on
    // campaign submissions in firestore.rules — and this path stays private to
    // its owner and staff regardless, so opening it exposes nothing: a file
    // only becomes world-readable when the publication workflow copies it into
    // published-media/, which no client can write.
    match /creator-submissions/{uid}/{campaignId}/{submissionId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && !isBlockedCreator()
        && withinSizeLimit()
        && allowedType();
      allow delete: if isSignedIn() && ((request.auth.uid == uid && !isBlockedCreator()) || isStaff());
    }

    // ---- Creator profile avatars: owner-writable, world-readable ------------
    match /creator-avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && !isBlockedCreator()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && request.auth.uid == uid && !isBlockedCreator();
    }

    // ---- Approved public media: world-readable, server-written only ---------
    // Populated by the publication workflow from approved submissions.
    match /published-media/{contentId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Community feed media: world-readable, owner-writable --------------
    // Photos and short videos attached to community posts. Public because the
    // feed itself is public; writes are limited to the poster's own prefix so
    // one member can never overwrite another's media.
    function communityImageOk() {
      return request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    function communityPostMediaOk() {
      return (request.resource.contentType.matches('image/.*')
          && request.resource.size < 12 * 1024 * 1024)
        || (request.resource.contentType.matches('video/.*')
          && request.resource.size < 128 * 1024 * 1024)
        || (request.resource.contentType.matches('audio/.*')
          && request.resource.size < 24 * 1024 * 1024);
    }

    match /community-media/{uid}/{postId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && communityPostMediaOk();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isStaff());
    }

    match /community-avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && communityImageOk();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isStaff());
    }

    match /community-banners/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && communityImageOk();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isStaff());
    }

    // ---- Sub-community pictures: world-readable, uploader-owned -------------
    // A community's profile picture and cover, uploaded before the community
    // document exists — which is why the prefix is the uploader's uid rather
    // than something a rule would have to look up. Community profiles are
    // public, private communities included, so these are too. JPEG, PNG and
    // WebP only: the app refuses anything else before upload, and so does this.
    match /community-spaces/{uid}/{communityId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isSignedIn() && (request.auth.uid == uid || isStaff());
    }

    // ---- Private community media: members only ------------------------------
    // Photos and clips posted inside a private community. The public
    // community-media prefix is world-readable and listable, so a private
    // post's files cannot live there. These rules read the member's row in
    // Firestore (cross-service rules), which the first deploy asks permission
    // to enable.
    function isPrivateSpaceMember(communityId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/communitySpaces/$(communityId)/memberships/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/communitySpaces/$(communityId)/memberships/$(request.auth.uid)).data.status == 'active';
    }

    match /community-private-media/{communityId}/{uid}/{postId}/{fileName} {
      allow read: if isPrivateSpaceMember(communityId) || isStaff();
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && communityPostMediaOk()
        && isPrivateSpaceMember(communityId);
      allow delete: if isSignedIn() && (request.auth.uid == uid || isStaff());
    }

    // ---- Lesson pictures: world-readable, admin-written ---------------------
    // "Which of these is a goat" needs the goat. These are uploaded from the
    // admin console rather than copied in by a Function, because the person
    // authoring the question has the photograph on the machine they are typing
    // on — so this is one of the very few prefixes a browser may write to, and
    // it is fenced accordingly: admins only, images only, and small enough to
    // open over a village connection. Read is open because a published lesson
    // is public and Learning works with no account at all.
    match /learn-images/{lessonId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // ---- Library audiobooks: world-readable, admin-written ------------------
    //
    // Audiobook contribution came off the phone. A narrated book involves a
    // rights holder, a narrator who is rarely the person uploading, and hours
    // of audio — none of which fits a mobile form, and all of which the review
    // queue would otherwise have to take on trust from whoever pressed send. It
    // is curated in the admin console instead, beside the Apps directory, so
    // this joins learn-images as one of the very few prefixes a browser may
    // write to, and it is fenced the same way: admins only, and only the two
    // kinds of file an audiobook is made of.
    //
    // The narration keeps the 500 MB ceiling a whole book needs; the cover
    // keeps the small one artwork gets everywhere else, because a picture that
    // big is a mistake somebody on a metered connection pays for. Read is open
    // because a published audiobook is public and the Collection plays to
    // signed-out listeners — and because the console calls getMetadata() on
    // these files when it reopens a record to edit.
    match /collection-audiobooks/{audiobookId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && ((request.resource.contentType.matches('audio/.*') && withinSizeLimit())
          || (request.resource.contentType.matches('image/.*')
              && request.resource.size < 8 * 1024 * 1024));
      allow delete: if isAdmin();
    }

    // ---- Ad creatives: world-readable, server-written only -------------------
    // An ad is served to every member, so its artwork is public. Nothing here
    // is client-writable: creatives arrive through the campaign workflow with
    // the Admin SDK, which bypasses these rules, and a browser that could write
    // its own file into this prefix could put any picture in front of the whole
    // membership.
    match /ad-creatives/{campaignId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Private AI-assisted Studio video outputs --------------------------
    // Provider results are imported here by trusted backend code. They stay
    // private until they enter the normal submission and review workflow.
    match /studio-video-jobs/{uid}/{jobId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow write: if false;
    }

    // ---- Kawuri uploads: private, temporary, owner-created ------------------
    // kawuri-uploads/{uid}/{purpose}/{uploadId}/{fileName}
    //
    // What the phone hands Kawuri to transcribe, analyse or use as a reference
    // image. Only the owner may create or read, once per object (no
    // overwrite), and only the types and sizes each purpose allows; the
    // callable re-reads the object's real metadata before using it. Temporary:
    // transcription audio is deleted when the request ends, and a bucket
    // lifecycle rule on this prefix removes anything abandoned
    // (firebase/storage-lifecycle.json).
    function kawuriAudioOk() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/(mp4|m4a|x-m4a|aac|mpeg|wav|x-wav|ogg|webm|flac)');
    }
    function kawuriReferenceOk() {
      return request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }
    function kawuriMediaOk() {
      return kawuriReferenceOk()
        || (request.resource.size < 200 * 1024 * 1024
          && request.resource.contentType.matches('video/(mp4|quicktime|webm|3gpp|mpeg)'))
        || (request.resource.size < 25 * 1024 * 1024
          && request.resource.contentType.matches('audio/(mp4|m4a|x-m4a|aac|mpeg|wav|x-wav|ogg|webm|flac)'));
    }

    match /kawuri-uploads/{uid}/{purpose}/{uploadId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && resource == null
        && ((purpose == 'audio' && kawuriAudioOk())
          || (purpose == 'reference' && kawuriReferenceOk())
          || (purpose == 'media' && kawuriMediaOk()));
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ---- Kawuri creations: private, server-written --------------------------
    // Generated images and videos, imported by trusted backend code. Readable
    // by their owner only; never written or deleted by a client — deletion
    // goes through deleteKawuriCreation, which removes the record with them.
    // Not covered by any lifecycle rule: a creation is kept until its owner
    // deletes it.
    match /kawuri-creations/{uid}/{taskId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- Default deny -------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
