rules_version = '2';

// Indigen World Firestore Security Rules.
//
// Model:
    //   * Roles are carried as the custom auth claim `role`. The current model
    //     accepts {creator, reviewer, admin, super_admin} while preserving the
    //     earlier {contributor, validator, admin} claims for existing accounts.
//     Everyday users (learners) sign in with no role and may read public content.
//   * Contributor documents are keyed by the auth uid, so a governance.contributor.id
//     that equals request.auth.uid identifies the owner of a content record.
//   * Privileged transitions (validate, reject, move to in_review, retire, reward
//     settlement, consent withdrawal, audit) are performed server-side in
//     services/functions with the Admin SDK, which bypasses these rules. Clients are
//     therefore never allowed to set those states directly.
//
// See docs/governance/data-safety.md and packages/contracts for the data shapes.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Role helpers -------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return isSignedIn() ? request.auth.token.get('role', null) : null;
    }
    function isAdmin() {
      return role() == 'admin' || role() == 'super_admin' || (isSignedIn() && request.auth.token.get('superAdmin', false) == true);
    }
    function isValidator() {
      return role() == 'validator' || role() == 'reviewer' || isAdmin();
    }
    function isContributor() {
      return role() == 'contributor' || isValidator();
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Staff = anyone who can moderate (validators + admins). Reviewers of creator
    // submissions and applications are staff.
    function isStaff() {
      return isValidator();
    }
    // Finance access is carried as dedicated claims, orthogonal to role, so an
    // ordinary admin does NOT automatically see payout detail (separation of
    // duties). Only a finance user or a super-admin qualifies.
    function isFinance() {
      return isSignedIn() && (request.auth.token.get('finance', false) == true || request.auth.token.get('superAdmin', false) == true);
    }

    function membershipPath(uid) {
      return /databases/$(database)/documents/creatorMemberships/$(uid);
    }

    function hasApprovedCreatorClaim(uid) {
      return isOwner(uid)
        && request.auth.token.get('creatorStatus', '') == 'approved'
        && request.auth.token.get('creatorRoles', []) is list
        && 'creator' in request.auth.token.get('creatorRoles', []);
    }

    function hasApprovedCreatorMembership(uid) {
      return isOwner(uid)
        && exists(membershipPath(uid))
        && get(membershipPath(uid)).data.status == 'approved'
        && 'creator' in get(membershipPath(uid)).data.roles;
    }

    function isApprovedCreator(uid) {
      return hasApprovedCreatorClaim(uid) || hasApprovedCreatorMembership(uid) || isStaff();
    }

    // A submission belongs to a campaign only when it names a real one. The
    // studio writes an empty (or 'open') campaign id for an everyday post, so
    // both shapes have to read as "not a campaign".
    function isCampaignSubmission(data) {
      return data.get('campaign', null) != null
        && data.campaign.get('id', '') is string
        && data.campaign.get('id', '') != ''
        && data.campaign.get('id', '') != 'open';
    }

    function isBlockedCreator(uid) {
      return isOwner(uid)
        && (
          request.auth.token.get('creatorStatus', '') in ['suspended', 'revoked', 'rejected']
          || (
            exists(membershipPath(uid))
            && get(membershipPath(uid)).data.status in ['suspended', 'revoked', 'rejected']
          )
        );
    }

    function publicationLicenceAllowed(licence) {
      return licence in [
        'community_restricted', 'cc_by', 'cc_by_sa', 'cc_by_nc',
        'public_domain'
      ];
    }

    function hasConsentReference(data) {
      return data.governance.consentStatus == 'granted'
        && data.governance.consent is map
        && data.governance.consent.collection == 'consentRecords'
        && data.governance.consent.id is string;
    }

    function consentIsActive(data) {
      let consent = get(/databases/$(database)/documents/consentRecords/$(data.governance.consent.id)).data;
      return consent.status == 'granted'
        && consent.subject.id == data.governance.contributor.id
        && 'publication' in consent.scope;
    }

    function consentWillBeActive(data) {
      let consent = getAfter(/databases/$(database)/documents/consentRecords/$(data.governance.consent.id)).data;
      return consent.status == 'granted'
        && consent.subject.id == data.governance.contributor.id
        && 'publication' in consent.scope;
    }

    function lifecycleIsValid(data) {
      return data.lifecycle.createdAt is string
        && data.lifecycle.updatedAt is string
        && data.lifecycle.version is int
        && data.lifecycle.version >= 1;
    }

    function validShortText(value, max) {
      return value is string && value.size() <= max;
    }

    function validTextFieldMap(fields) {
      return fields is map
        && fields.keys().hasOnly([
          'fullName', 'displayName', 'roleTitle', 'teamCompany', 'email',
          'phone', 'location', 'sitePurpose', 'audience', 'visitorAction',
          'siteName', 'tagline', 'brandColors', 'preferredStyle',
          'inspirationLinks', 'shortBio', 'services', 'projects',
          'testimonials', 'achievements', 'logoAvailable',
          'profilePhotoAvailable', 'mediaNotes', 'socialLinks', 'bookingLink',
          'paymentLink', 'portfolioLinks', 'contactFields',
          'submissionDestination', 'extraNotes', 'exclusions', 'deadline'
        ])
        && fields.keys().hasAll([
          'fullName', 'email', 'sitePurpose', 'audience', 'visitorAction',
          'siteName', 'shortBio'
        ])
        && validShortText(fields.fullName, 160)
        && validShortText(fields.displayName, 160)
        && validShortText(fields.roleTitle, 160)
        && validShortText(fields.teamCompany, 160)
        && validShortText(fields.email, 180)
        && validShortText(fields.phone, 80)
        && validShortText(fields.location, 160)
        && validShortText(fields.sitePurpose, 1600)
        && validShortText(fields.audience, 1600)
        && validShortText(fields.visitorAction, 1600)
        && validShortText(fields.siteName, 180)
        && validShortText(fields.tagline, 280)
        && validShortText(fields.brandColors, 500)
        && validShortText(fields.preferredStyle, 500)
        && validShortText(fields.inspirationLinks, 1600)
        && validShortText(fields.shortBio, 2400)
        && validShortText(fields.services, 2400)
        && validShortText(fields.projects, 2400)
        && validShortText(fields.testimonials, 2400)
        && validShortText(fields.achievements, 1600)
        && validShortText(fields.logoAvailable, 80)
        && validShortText(fields.profilePhotoAvailable, 80)
        && validShortText(fields.mediaNotes, 1600)
        && validShortText(fields.socialLinks, 1600)
        && validShortText(fields.bookingLink, 500)
        && validShortText(fields.paymentLink, 500)
        && validShortText(fields.portfolioLinks, 1600)
        && validShortText(fields.contactFields, 1200)
        && validShortText(fields.submissionDestination, 500)
        && validShortText(fields.extraNotes, 2400)
        && validShortText(fields.exclusions, 1600)
        && validShortText(fields.deadline, 160);
    }

    function validTeamSiteRequest(data) {
      return data.keys().hasOnly(['formVersion', 'status', 'submittedAt', 'fields', 'desiredPages', 'features'])
        && data.formVersion == 1
        && data.status == 'new'
        && validShortText(data.submittedAt, 40)
        && validTextFieldMap(data.fields)
        && data.fields.fullName.size() > 0
        && data.fields.email.size() > 0
        && data.fields.sitePurpose.size() > 0
        && data.fields.audience.size() > 0
        && data.fields.visitorAction.size() > 0
        && data.fields.siteName.size() > 0
        && data.fields.shortBio.size() > 0
        && data.desiredPages is list
        && data.desiredPages.size() > 0
        && data.desiredPages.size() <= 12
        && data.features is list
        && data.features.size() <= 16;
    }

    function submissionReady(data) {
      return data.governance.validationStatus == 'submitted'
        && data.governance.validator == null
        && publicationLicenceAllowed(data.governance.licence)
        && hasConsentReference(data)
        && consentWillBeActive(data)
        && lifecycleIsValid(data);
    }

    // ---- Content helpers (lexical entries, sentence pairs) ------------------
    function contentReadable(data) {
      return
        // Public, validated content is world-readable.
        (data.governance.validationStatus == 'validated'
          && data.governance.culturalPermissionTier == 'public'
          && publicationLicenceAllowed(data.governance.licence)
          && hasConsentReference(data)
          && consentIsActive(data))
        // Validators and admins can read everything, including restricted tiers.
        || isValidator()
        // Signed-in contributors can read validated community-tier content...
        || (isContributor()
          && data.governance.validationStatus == 'validated'
          && data.governance.culturalPermissionTier == 'community_only'
          && publicationLicenceAllowed(data.governance.licence)
          && hasConsentReference(data)
          && consentIsActive(data))
        // ...and their own records in any state.
        || (isContributor() && data.governance.contributor.id == request.auth.uid);
    }

    function contentCreatable() {
      return isContributor()
        && request.resource.data.governance.contributor.id == request.auth.uid
        && request.resource.data.governance.validator == null
        && lifecycleIsValid(request.resource.data)
        && (
          (request.resource.data.governance.validationStatus == 'draft'
            && request.resource.data.governance.consentStatus in ['pending', 'granted'])
          || submissionReady(request.resource.data)
        );
    }

    function contentUpdatable() {
      return isContributor()
        // Only the owner, and the owner cannot reassign ownership.
        && resource.data.governance.contributor.id == request.auth.uid
        && request.resource.data.governance.contributor.id == request.auth.uid
        // Owners may edit their own drafts / returned items and (re)submit them,
        // but may never grant validation or attach a validator.
        && resource.data.governance.validationStatus in ['draft', 'needs_changes']
        && request.resource.data.governance.validationStatus in ['draft', 'submitted']
        && request.resource.data.governance.validator == null
        && request.resource.data.lifecycle.createdAt == resource.data.lifecycle.createdAt
        && request.resource.data.lifecycle.updatedAt is string
        && request.resource.data.lifecycle.version == resource.data.lifecycle.version + 1
        && (
          request.resource.data.governance.validationStatus == 'draft'
          || submissionReady(request.resource.data)
        );
    }

    // ---- Registry entities: public read, admin-managed ---------------------
    match /communities/{communityId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /languages/{languageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /dialects/{dialectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /validators/{validatorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- Content collections ----------------------------------------------
    match /lexicalEntries/{entryId} {
      allow read: if contentReadable(resource.data);
      allow create: if request.resource.data.id == entryId && contentCreatable();
      allow update: if request.resource.data.id == entryId && contentUpdatable();
      allow delete: if false;
    }
    match /sentencePairs/{pairId} {
      allow read: if contentReadable(resource.data);
      allow create: if request.resource.data.id == pairId && contentCreatable();
      allow update: if request.resource.data.id == pairId && contentUpdatable();
      allow delete: if false;
    }

    // Legacy Project Kasena dictionary used by the mobile Collection. The app
    // deliberately queries `isPublished == true`, so drafts and approved-but-
    // not-yet-published rows remain private to staff.
    match /dictionaryEntries/{entryId} {
      allow read: if resource.data.get('isPublished', false) == true || isStaff();
      allow write: if false;
    }

    // ---- Contributors: self-managed profile, no privilege escalation -------
    match /contributors/{contributorId} {
      allow read: if isOwner(contributorId) || isValidator();
      allow create: if isAdmin() || (
        isOwner(contributorId)
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && (!('points' in request.resource.data) || request.resource.data.points == 0)
      );
      // Owners may edit descriptive fields but not roles, status, points, or identity.
      allow update: if isAdmin() || (
        isOwner(contributorId)
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.roles == resource.data.roles
        && request.resource.data.status == resource.data.status
        && request.resource.data.points == resource.data.points
      );
      allow delete: if isAdmin();
    }

    // ---- Consent records: owner may create, changes go through Functions ----
    match /consentRecords/{consentId} {
      allow read: if isValidator() || (
        isSignedIn() && resource.data.subject.id == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.id == consentId
        && request.resource.data.subject.collection == 'contributors'
        && request.resource.data.subject.id == request.auth.uid
        && request.resource.data.grantedBy.collection == 'contributors'
        && request.resource.data.grantedBy.id == request.auth.uid
        && request.resource.data.status == 'granted'
        && 'publication' in request.resource.data.scope
        && request.resource.data.effectiveFrom is string
        && lifecycleIsValid(request.resource.data);
      // Withdrawal / expiry transitions are privileged (audited) — server only.
      allow update, delete: if false;
    }

    // ---- Reviews: written by Functions when a validation decision is made ---
    match /reviews/{reviewId} {
      allow read: if isValidator();
      allow write: if false;
    }

    // ---- Audit log: append-only, server-authored, admin-readable ------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ======================================================================
    // Creator system (TribeStudio founding creators)
    // ======================================================================

    // ---- Platform configuration: public-read, admin-managed -----------------
    // Keeps dialects, categories, guidelines and the WhatsApp URL out of the
    // frontend. Guests read; only admins write.
    match /platformConfiguration/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Campaigns: public campaigns are guest-readable, admin-managed -------
    // Submission availability is derived from `status`; admins move the lifecycle
    // so submissions open with no client redeploy. The collection-contributions
    // campaign is a backend-owned routing record and may never be client-mutated,
    // including by an admin client.
    match /campaigns/{campaignId} {
      allow read: if resource.data.visibility == 'public' || isStaff();
      allow create, update: if campaignId != 'collection-contributions'
        && isAdmin()
        && request.resource.data.id == campaignId;
      allow delete: if false;
    }

    // ---- Creator profiles: self-managed public + contact fields -------------
    // Owners may edit descriptive fields; reference, status and consent history
    // are server-managed and cannot be self-set.
    match /creatorProfiles/{creatorId} {
      allow read: if isOwner(creatorId) || isStaff();
      allow create: if isAdmin() || (
        isOwner(creatorId)
        && request.resource.data.id == creatorId
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.get('status', 'waitlisted') == 'waitlisted'
        && lifecycleIsValid(request.resource.data)
      );
      allow update: if isAdmin() || (
        isOwner(creatorId)
        && !isBlockedCreator(creatorId)
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.id == resource.data.id
        && request.resource.data.get('reference', '') == resource.data.get('reference', '')
        && request.resource.data.get('status', 'waitlisted') == resource.data.get('status', 'waitlisted')
        && request.resource.data.get('consentRefs', []) == resource.data.get('consentRefs', [])
        && request.resource.data.public.get('username', '') == resource.data.public.get('username', '')
        && request.resource.data.lifecycle.version == resource.data.lifecycle.version + 1
      );
      allow delete: if isAdmin();
    }

    // ---- Creator memberships: server-owned approval and assignment records --
    // Applicants and creators may read their own standing, but cannot mutate
    // status, roles, languages, campaigns, permissions or admin decision fields.
    match /creatorMemberships/{creatorId} {
      allow read: if isOwner(creatorId) || isStaff();
      allow write: if false;
    }

    match /creatorUsernames/{username} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Creator applications: created + decided server-side ----------------
    // Registration runs through the submitCreatorApplication function (dedupe,
    // reference number, atomic profile + notification). Owners and staff read;
    // no client may write, so status transitions stay privileged.
    match /creatorApplications/{applicationId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.authUid == request.auth.uid
      );
      allow write: if false;
    }

    // ---- Submissions: owner-managed; approval is a campaign-only gate -------
    // Two routes, deliberately different:
    //
    //   * An everyday post carries no campaign. Any signed-in account that is
    //     not suspended may create and edit it, and the onSubmissionWritten
    //     trigger publishes it straight to Explore. No verification, no queue —
    //     what is asked instead is that the creator holds the rights and has
    //     consent, which they attest in the form.
    //   * A campaign entry carries a real campaign id. Those come with rewards
    //     and eligibility, so they stay restricted to approved creators and
    //     keep the reviewed publication path.
    //
    // Either way the owner may never set moderation state, approve, schedule or
    // publish: those fields are written only by the trusted backend.
    match /submissions/{submissionId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.authUid == request.auth.uid
      );
      allow create: if isSignedIn()
        && !isBlockedCreator(request.auth.uid)
        && (!isCampaignSubmission(request.resource.data) || isApprovedCreator(request.auth.uid))
        && request.resource.data.id == submissionId
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.creator.id == request.auth.uid
        && request.resource.data.status in ['DRAFT', 'SUBMITTED']
        // Nested lookup has to go one hop at a time: Map.get() takes a key,
        // not a dotted path, so the single-string form silently matched
        // nothing and let a client stamp its own publication reference on a
        // brand-new submission.
        && request.resource.data.get('moderation', {}).get('publishedContent', null) == null
        && lifecycleIsValid(request.resource.data);
      allow update: if isSignedIn()
        && !isBlockedCreator(request.auth.uid)
        && (!isCampaignSubmission(request.resource.data) || isApprovedCreator(request.auth.uid))
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == resource.data.authUid
        // An open post stays editable after it is live; a campaign entry is
        // frozen the moment it is submitted for review.
        && resource.data.status in ['DRAFT', 'NEEDS_REVISION', 'PUBLISHED']
        && (resource.data.status != 'PUBLISHED' || !isCampaignSubmission(resource.data))
        && request.resource.data.status in ['DRAFT', 'SUBMITTED', 'RESUBMITTED', 'WITHDRAWN']
        // Moderation outcome fields are frozen to their prior values.
        && request.resource.data.get('moderation', {}) == resource.data.get('moderation', {})
        && request.resource.data.get('rewardEligible', false) == resource.data.get('rewardEligible', false)
        && request.resource.data.lifecycle.version == resource.data.lifecycle.version + 1;
      allow delete: if false;
    }

    // ---- Published content: public read of published records, server-write ---
    // The only collection the mobile app consumes. Created / mutated exclusively
    // by the trusted publication workflow.
    match /publishedContent/{contentId} {
      allow read: if resource.data.publicationStatus == 'published' || isStaff();
      allow write: if false;
    }

    // Mobile contributions for the four Collection destinations. The callable
    // submitCollectionContribution function validates consent and atomically
    // creates both this private status record and its canonical review
    // submission. No client may bypass that bridge or mutate review state.
    match /collectionContributions/{contributionId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.authUid == request.auth.uid
      );
      allow write: if false;
    }

    // ---- Advertising campaigns: owner reads own, server writes everything ---
    //
    // A campaign is money. Its status, what it has been charged, whether it is
    // paid and what it has earned in impressions are all decided server-side,
    // so this collection is read-only to every client — including its owner.
    // Creating, editing and cancelling all go through callables in ads.ts,
    // which price the campaign themselves rather than believing a total that
    // arrived from a phone.
    match /adCampaigns/{campaignId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.ownerUid == request.auth.uid
      );
      allow write: if false;
    }

    // ---- Notifications: owner reads own; owner may only flip `read` ----------
    match /notifications/{notificationId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.authUid == request.auth.uid
      );
      allow create: if false;
      allow update: if isSignedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'lifecycle']);
      allow delete: if false;
    }

    // ---- Creator consent ledger: server-authored, immutable -----------------
    match /creatorConsents/{consentId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.get('subject.id', '') == request.auth.uid
      );
      allow write: if false;
    }

    // ---- Support requests: owner creates, staff resolves --------------------
    match /supportRequests/{requestId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.authUid == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.get('status', 'open') == 'open';
      allow update, delete: if isStaff();
    }

    // ---- Communications: admin-managed announcements and delivery logs -------
    match /communications/{communicationId} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ---- Team site intake: public submit, staff review ----------------------
    match /teamSiteRequests/{requestId} {
      allow create: if validTeamSiteRequest(request.resource.data);
      allow read: if isStaff();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- Public form intake (Get Involved / Interests, Contact): staff review ---
    match /publicFormSubmissions/{submissionId} {
      allow read: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ---- Newsletter subscribers: staff review, admin manage -----------------
    match /newsletterSubscribers/{subscriberId} {
      allow read: if isStaff();
      allow update, delete: if isAdmin();
    }

    // ---- Payouts: restricted to finance / super-admin, server-write ---------
    // Payout detail is masked in the UI and never client-writable.
    match /payouts/{payoutId} {
      allow read: if isFinance();
      allow write: if false;
    }

    // ======================================================================
    // Community feed (mobile "Community" tab)
    // ======================================================================
    //
    // Flat, edge-document model so every client query is a single indexed read
    // and no member ever needs write access to another member's documents:
    //
    //   communityProfiles/{uid}                — public identity, owner-written
    //   communityUsernames/{username}          — handle uniqueness registry
    //   communityPosts/{postId}                — posts and replies (parentId)
    //   communityLikes/{uid}_{postId}          — like edges, owner-written
    //   communityReposts/{uid}_{postId}        — feed reshare edges
    //   communityQuotes/{uid}_{postId}         — quote-post edges
    //   communityViews/{uid}_{postId}          — unique impressions
    //   communityPollVotes/{uid}_{postId}      — immutable poll votes
    //   communityBookmarks/{uid}_{postId}      — private saves, owner-only
    //   communityFollows/{from}_{to}           — follow edges, follower-written
    //   communityReports/{reportId}            — moderation queue
    //
    // Follower / following / post totals are computed with aggregate count()
    // queries on the client, so there are no cross-user counter writes. The one
    // exception is likeCount and replyCount on a post, which are constrained
    // below to a single-step change backed by a real edge document.

    function communityOwnsEdge(edgeId, uid, otherId) {
      return edgeId == uid + '_' + otherId;
    }

    function validCommunityText(value, max) {
      return value is string && value.size() <= max;
    }

    function communityLikePath(postId) {
      return /databases/$(database)/documents/communityLikes/$(request.auth.uid + '_' + postId);
    }

    function communityRepostPath(postId) {
      return /databases/$(database)/documents/communityReposts/$(request.auth.uid + '_' + postId);
    }

    function communityQuotePath(postId) {
      return /databases/$(database)/documents/communityQuotes/$(request.auth.uid + '_' + postId);
    }

    function communityViewPath(postId) {
      return /databases/$(database)/documents/communityViews/$(request.auth.uid + '_' + postId);
    }

    // A member may change likeCount by exactly one step, and only when the
    // matching like edge is created or removed in the same commit.
    function communityLikeDelta(postId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && (
          (request.resource.data.likeCount == resource.data.likeCount + 1
            && !exists(communityLikePath(postId))
            && existsAfter(communityLikePath(postId)))
          || (request.resource.data.likeCount == resource.data.likeCount - 1
            && exists(communityLikePath(postId))
            && !existsAfter(communityLikePath(postId)))
        );
    }

    // Reply totals move one step at a time. The reply document id is not known
    // to this rule, so the constraint is the single-step change itself.
    function communityReplyDelta() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && (
          request.resource.data.replyCount == resource.data.replyCount + 1
          || request.resource.data.replyCount == resource.data.replyCount - 1
        );
    }

    function communityRepostDelta(postId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repostCount'])
        && (
          (request.resource.data.repostCount == resource.data.get('repostCount', 0) + 1
            && !exists(communityRepostPath(postId))
            && existsAfter(communityRepostPath(postId)))
          || (request.resource.data.repostCount == resource.data.get('repostCount', 0) - 1
            && exists(communityRepostPath(postId))
            && !existsAfter(communityRepostPath(postId)))
        );
    }

    function communityQuoteDelta(postId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quoteCount'])
        && (
          (request.resource.data.quoteCount == resource.data.get('quoteCount', 0) + 1
            && !exists(communityQuotePath(postId))
            && existsAfter(communityQuotePath(postId)))
          || (request.resource.data.quoteCount == resource.data.get('quoteCount', 0) - 1
            && exists(communityQuotePath(postId))
            && !existsAfter(communityQuotePath(postId)))
        );
    }

    function communityViewDelta(postId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1
        && !exists(communityViewPath(postId))
        && existsAfter(communityViewPath(postId));
    }

    match /communityProfiles/{uid} {
      // Public so guests can read the feed before signing in.
      allow read: if true;
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z][a-z0-9_]{2,19}$')
        && validCommunityText(request.resource.data.displayName, 80)
        && request.resource.data.displayName.size() > 0
        && validCommunityText(request.resource.data.get('bio', ''), 300)
        && validCommunityText(request.resource.data.get('location', ''), 80)
        && validCommunityText(request.resource.data.get('dialect', ''), 80)
        && request.resource.data.get('isVerified', false) == false;
      // Handle, uid and verification are frozen after creation.
      allow update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.get('isVerified', false) == resource.data.get('isVerified', false)
        && validCommunityText(request.resource.data.displayName, 80)
        && request.resource.data.displayName.size() > 0
        && validCommunityText(request.resource.data.get('bio', ''), 300)
        && validCommunityText(request.resource.data.get('location', ''), 80)
        && validCommunityText(request.resource.data.get('dialect', ''), 80)
      );
      allow delete: if isAdmin();
    }

    match /communityUsernames/{username} {
      allow read: if true;
      // Create-only: an existing document makes the handle unavailable, which
      // is what enforces uniqueness.
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
        && validCommunityText(request.resource.data.text, 500)
        && request.resource.data.likeCount == 0
        && request.resource.data.replyCount == 0
        && request.resource.data.get('repostCount', 0) == 0
        && request.resource.data.get('quoteCount', 0) == 0
        && request.resource.data.get('viewCount', 0) == 0
        && request.resource.data.media is list
        && request.resource.data.media.size() <= 4
        && (request.resource.data.get('quotedPostId', null) == null
          || request.resource.data.quotedPostId is string)
        && (request.resource.data.get('poll', null) == null
          || (request.resource.data.poll is map
            && request.resource.data.poll.options is list
            && request.resource.data.poll.options.size() >= 2
            && request.resource.data.poll.options.size() <= 4
            && request.resource.data.poll.totalVotes == 0
            && request.resource.data.poll.endsAt is timestamp))
        && (request.resource.data.parentId == null
          || request.resource.data.parentId is string);
      // The author may edit their own body text; anyone signed in may move a
      // counter by one step under the constraints above.
      allow update: if (
        isSignedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
        && validCommunityText(request.resource.data.text, 500)
      ) || (
        isSignedIn() && communityLikeDelta(postId)
      ) || (
        isSignedIn() && communityReplyDelta()
      ) || (
        isSignedIn() && communityRepostDelta(postId)
      ) || (
        isSignedIn() && communityQuoteDelta(postId)
      ) || (
        isSignedIn() && communityViewDelta(postId)
      ) || isStaff();
      allow delete: if isSignedIn()
        && (resource.data.authorId == request.auth.uid || isStaff());
    }

    match /communityLikes/{likeId} {
      // Public so the feed can show who appreciated a post.
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && communityOwnsEdge(likeId, request.auth.uid, request.resource.data.postId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityReposts/{repostId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.reposterId == request.auth.uid
        && request.resource.data.postId is string
        && communityOwnsEdge(repostId, request.auth.uid, request.resource.data.postId)
        && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId))
        && getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.repostCount
          == get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.get('repostCount', 0) + 1;
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.reposterId == request.auth.uid
        && getAfter(/databases/$(database)/documents/communityPosts/$(resource.data.postId)).data.repostCount
          == get(/databases/$(database)/documents/communityPosts/$(resource.data.postId)).data.get('repostCount', 0) - 1;
    }

    match /communityQuotes/{quoteId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sourcePostId is string
        && request.resource.data.quotePostId is string
        && communityOwnsEdge(quoteId, request.auth.uid, request.resource.data.sourcePostId)
        && existsAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.quotePostId))
        && getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.quotePostId)).data.authorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.quotePostId)).data.quotedPostId == request.resource.data.sourcePostId
        && getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.sourcePostId)).data.quoteCount
          == get(/databases/$(database)/documents/communityPosts/$(request.resource.data.sourcePostId)).data.get('quoteCount', 0) + 1;
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/communityPosts/$(resource.data.sourcePostId)).data.quoteCount
          == get(/databases/$(database)/documents/communityPosts/$(resource.data.sourcePostId)).data.get('quoteCount', 0) - 1;
    }

    match /communityViews/{viewId} {
      // `resource == null` is the edge a member has not written yet. Without
      // this clause the client cannot ask whether it has already counted a
      // post: dereferencing a missing document errors, and the error reads as
      // a refusal, which would leave every first impression uncounted.
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.viewerId == request.auth.uid
        || get(/databases/$(database)/documents/communityPosts/$(resource.data.postId)).data.authorId == request.auth.uid
        || isStaff()
      );
      allow create: if isSignedIn()
        && request.resource.data.viewerId == request.auth.uid
        && request.resource.data.postId is string
        && communityOwnsEdge(viewId, request.auth.uid, request.resource.data.postId)
        && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId))
        && getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.viewCount
          == get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.get('viewCount', 0) + 1;
      allow update, delete: if false;
    }

    match /communityPollVotes/{voteId} {
      // See communityViews: a member must be able to read the absence of their
      // own ballot before casting it.
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.uid == request.auth.uid
        || get(/databases/$(database)/documents/communityPosts/$(resource.data.postId)).data.authorId == request.auth.uid
        || isStaff()
      );
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.optionId is string
        && communityOwnsEdge(voteId, request.auth.uid, request.resource.data.postId)
        && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId));
      allow update, delete: if false;
    }

    match /communityBookmarks/{bookmarkId} {
      // Saves are private to their owner.
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && communityOwnsEdge(bookmarkId, request.auth.uid, request.resource.data.postId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityHiddenPosts/{edgeId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && communityOwnsEdge(edgeId, request.auth.uid, request.resource.data.postId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityMutes/{edgeId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId != request.auth.uid
        && communityOwnsEdge(edgeId, request.auth.uid, request.resource.data.targetId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityBlocks/{edgeId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId != request.auth.uid
        && communityOwnsEdge(edgeId, request.auth.uid, request.resource.data.targetId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityFollows/{followId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && communityOwnsEdge(followId, request.auth.uid, request.resource.data.followingId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    // ---- Community notifications: server-authored, owner reads and marks ----
    // Every row is written by a Cloud Functions trigger in response to
    // something that actually happened (a like, a reply, a follow, a mention, a
    // publication). A client may never create one — an alert is a channel
    // straight to somebody's lock screen, and forging one must be impossible —
    // and may only ever flip `read` on its own rows.
    match /communityNotifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if false;
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if false;
    }

    // ---- Push registrations: one row per device, owned by one account -------
    // Keyed by the FCM token itself, so a token refresh replaces the old row
    // rather than accumulating dead devices, and a token can only ever be
    // claimed by the account currently holding it. Nobody may read the
    // collection: knowing another member's tokens is knowing how to reach their
    // handset.
    match /communityDevices/{token} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token == token
        // Whether message bodies may be drawn on this handset's lock screen.
        // Optional — rows written before the preference existed have no value,
        // and the fan-out reads a missing value as "yes", which is what those
        // devices were already doing.
        && request.resource.data.get('messagePreviews', true) is bool;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityReports/{reportId} {
      allow read: if isStaff();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.postId is string
        && validCommunityText(request.resource.data.reason, 300)
        && request.resource.data.get('status', 'open') == 'open';
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ======================================================================
    // Explore reel engagement
    // ======================================================================
    //
    // Appreciations, keeps, impressions and replies on published reels. Same
    // flat, edge-keyed shape as the community feed, and for the same reason:
    // every member writes only documents they own.
    //
    //   reelLikes/{uid}_{reelId}     — appreciation edges, world-readable
    //   reelSaves/{uid}_{reelId}     — private keeps
    //   reelViews/{uid}_{reelId}     — one impression per member per reel
    //   reelComments/{commentId}     — the reply thread on a reel
    //
    // There are no counter documents. Totals are read with aggregate count()
    // queries over these edges, exactly as follower and post totals already
    // are — so no client ever needs write access to a shared number, and a
    // count cannot drift away from the edges it describes.

    function reelOwnsEdge(edgeId, uid, reelId) {
      return edgeId == uid + '_' + reelId;
    }

    match /reelLikes/{likeId} {
      // Public so a reel can show how many people appreciated it.
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reelId is string
        && reelOwnsEdge(likeId, request.auth.uid, request.resource.data.reelId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /reelSaves/{saveId} {
      // Keeps are private to their owner.
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reelId is string
        && reelOwnsEdge(saveId, request.auth.uid, request.resource.data.reelId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /reelViews/{viewId} {
      // A viewer may read their own row; the public total comes from an
      // aggregate count, which does not require reading the documents.
      allow read: if isSignedIn()
        && (resource.data.viewerId == request.auth.uid || isStaff());
      // Set rather than create: the edge id makes a repeat view idempotent,
      // so scrolling back to a reel rewrites one row instead of adding one.
      allow create, update: if isSignedIn()
        && request.resource.data.viewerId == request.auth.uid
        && request.resource.data.reelId is string
        && reelOwnsEdge(viewId, request.auth.uid, request.resource.data.reelId);
      allow delete: if false;
    }

    match /reelComments/{commentId} {
      // The reply thread under a public reel is public.
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.reelId is string
        && exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 400;
      allow update: if false;
      allow delete: if isSignedIn()
        && (resource.data.authorId == request.auth.uid || isStaff());
    }

    // ======================================================================
    // Private conversations
    // ======================================================================
    //
    //   communityChats/{a_b}                  — the thread, its stamps, unread
    //   communityChats/{a_b}/messages/{msgId} — the messages themselves
    //
    // A thread id is the two account ids in sorted order joined by an
    // underscore. That is what the create rule checks, and it is what makes a
    // pair of members unable to end up with two conversations: whichever of
    // them opens one first computes the same id.
    //
    // Both participants may write the thread document. That is wider than the
    // strict owner-only grant used elsewhere, and deliberately so: a sender has
    // to be able to raise the *other* side's unread count, and a reader has to
    // be able to clear their own. The blast radius is the two people already in
    // the conversation, and the participant list itself is frozen.

    function chatParticipants(chatId) {
      return get(/databases/$(database)/documents/communityChats/$(chatId)).data.participants;
    }

    match /communityChats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && chatId == request.resource.data.participants[0]
            + '_' + request.resource.data.participants[1];
      // Both participants may write this document — a sender has to raise the
      // other side's unread count, and a reader has to clear their own. Two
      // fields are carved out of that grant, because "the other person can
      // write here" would otherwise mean "the other person can silence you".
      //
      //   mutedBy    muting is a decision about your own alerts. Take your own
      //              uid out of the list before and the list after, and what
      //              is left must match — which is exactly "you changed only
      //              your own membership". Compared as sets because order and
      //              duplicates carry no meaning here.
      //   lastPushAt the fan-out's own debounce stamp. A client that could
      //              forge it could hold the quiet window open and stop the
      //              other person's follow-up messages from ever ringing.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.get('mutedBy', []).toSet()
            .difference([request.auth.uid].toSet())
            == resource.data.get('mutedBy', []).toSet()
                .difference([request.auth.uid].toSet())
        && !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['lastPushAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in chatParticipants(chatId);
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in chatParticipants(chatId)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        // A message is a record of what was said. It may be withdrawn by the
        // person who said it, never rewritten after the fact.
        allow update: if false;
        allow delete: if isSignedIn()
          && (resource.data.senderId == request.auth.uid || isStaff());
      }
    }

    // ======================================================================
    // LEARNING PATH
    // ======================================================================

    // ---- Lessons: public read of published lessons, admin-managed -----------
    // The Kasem path used to be a constant compiled into the app, so adding a
    // lesson meant shipping a release and every member below that version kept
    // the old unit forever. Lessons live here now and the app treats its
    // bundled set as a fallback for a first launch with no connection.
    //
    // Unpublished lessons are staff-only: a half-written question is a wrong
    // answer waiting to be taught.
    match /learnLessons/{lessonId} {
      allow read: if resource.data.get('published', false) == true || isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.questions is list
        && request.resource.data.questions.size() > 0
        && request.resource.data.questions.size() <= 20;
      allow delete: if isAdmin();
    }

    // ---- Learning progress: one private row per member ----------------------
    // Learning works signed out, so the device copy stays authoritative for a
    // guest; this is what makes a finished unit survive a new phone once there
    // is an account to attach it to. Nobody but the owner may read it — what
    // somebody has and has not learned is theirs.
    match /learnProgress/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.completedLessons is list
        && request.resource.data.completedLessons.size() <= 2000
        && request.resource.data.get('xp', 0) is int
        && request.resource.data.get('xp', 0) >= 0
        && request.resource.data.get('streakDays', 0) is int
        && request.resource.data.get('streakDays', 0) >= 0;
      allow delete: if isOwner(uid);
    }

    // ======================================================================
    // COLLECTION: APPS AND SHOP
    // ======================================================================

    // ---- App directory: public read, admin-managed --------------------------
    // Kasem apps, scripture apps and the other Indigen World releases, each a
    // link out to a store. Guest-readable because Collection is.
    match /collectionApps/{appId} {
      allow read: if resource.data.get('published', false) == true || isStaff();
      allow write: if isAdmin();
    }

    // ---- Shop catalogue: public read, admin-managed --------------------------
    match /shopProducts/{productId} {
      allow read: if resource.data.get('published', false) == true || isStaff();
      allow write: if isAdmin();
    }

    // ---- Shop orders: a member places one, staff fulfil it ------------------
    // No payment is taken in the app. An order is a request to buy, answered by
    // a person — which is why the member may create one and then only read it,
    // and why `status` is not theirs to move.
    match /shopOrders/{orderId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.contact is string
        && request.resource.data.contact.size() > 0
        && request.resource.data.contact.size() <= 400;
      allow update: if isStaff();
      allow delete: if false;
    }

    // ---- Default deny -------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
