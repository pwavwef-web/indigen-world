rules_version = '2';

// Indigen World Firestore Security Rules.
//
// Model:
    //   * Roles are carried as the custom auth claim `role`. The current model
    //     accepts {creator, reviewer, admin, super_admin} while preserving the
    //     earlier {contributor, validator, admin} claims for existing accounts.
//     Everyday users (learners) sign in with no role and may read public content.
//   * Contributor documents are keyed by the auth uid, so a governance.contributor.id
//     that equals request.auth.uid identifies the owner of a content record.
//   * Privileged transitions (validate, reject, move to in_review, retire, reward
//     settlement, consent withdrawal, audit) are performed server-side in
//     services/functions with the Admin SDK, which bypasses these rules. Clients are
//     therefore never allowed to set those states directly.
//
// See docs/governance/data-safety.md and packages/contracts for the data shapes.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Role helpers -------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return isSignedIn() ? request.auth.token.get('role', null) : null;
    }
    function isAdmin() {
      return role() == 'admin' || role() == 'super_admin' || (isSignedIn() && request.auth.token.get('superAdmin', false) == true);
    }
    function isValidator() {
      return role() == 'validator' || role() == 'reviewer' || isAdmin();
    }
    function isContributor() {
      return role() == 'contributor' || isValidator();
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Staff = anyone who can moderate (validators + admins). Reviewers of creator
    // submissions and applications are staff.
    function isStaff() {
      return isValidator();
    }
    // Finance access is carried as dedicated claims, orthogonal to role, so an
    // ordinary admin does NOT automatically see payout detail (separation of
    // duties). Only a finance user or a super-admin qualifies.
    function isFinance() {
      return isSignedIn() && (request.auth.token.get('finance', false) == true || request.auth.token.get('superAdmin', false) == true);
    }

    function membershipPath(uid) {
      return /databases/$(database)/documents/creatorMemberships/$(uid);
    }

    // ---- Supporter marks ----------------------------------------------------
    //
    // A supporter mark is bought through Google Play and written by
    // services/functions/src/subscriptions.ts once Play has confirmed the
    // purchase. Posts and reel comments carry an author stamp so the feed can
    // draw a byline without a profile read per row, and that stamp is written
    // by the phone — so the one field in it that money buys is checked against
    // the entitlement rather than believed.
    //
    // ── Why the profile and not the entitlement ──────────────────────────
    // `communityProfiles/{uid}` carries a mirror of the mark, written by the
    // same backend and frozen against the member's own writes by the rules
    // below. Reading it here rather than `entitlements/{uid}` costs one
    // document instead of two, and — the part that matters — it needs no
    // existence guard: every rule that calls this already requires the
    // author's profile to exist, so there is no `get()` on a missing document
    // to go wrong. A profile created after the subscription is stamped by
    // `onCommunityProfileCreated` in subscriptions.ts, which is what keeps the
    // mirror from lagging a month behind the purchase.
    //
    // One extra document read on a post or comment *create*, and none on any
    // read. That is the right side of the trade: writes here are a handful per
    // member per day, and the alternative is a badge anybody can put on
    // themselves by editing one string.
    function grantedSupporterMark() {
      return get(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
        .data.get('supporterMark', '');
    }

    function claimedSupporterMark(data) {
      return data.get('author', {}).get('supporterMark', '');
    }

    function supporterMarkIsEarned(data) {
      return claimedSupporterMark(data) == ''
        || claimedSupporterMark(data) == grantedSupporterMark();
    }

    function hasApprovedCreatorClaim(uid) {
      return isOwner(uid)
        && request.auth.token.get('creatorStatus', '') == 'approved'
        && request.auth.token.get('creatorRoles', []) is list
        && 'creator' in request.auth.token.get('creatorRoles', []);
    }

    function hasApprovedCreatorMembership(uid) {
      return isOwner(uid)
        && exists(membershipPath(uid))
        && get(membershipPath(uid)).data.status == 'approved'
        && 'creator' in get(membershipPath(uid)).data.roles;
    }

    function isApprovedCreator(uid) {
      return hasApprovedCreatorClaim(uid) || hasApprovedCreatorMembership(uid) || isStaff();
    }

    // A submission belongs to a campaign only when it names a real one. The
    // studio writes an empty (or 'open') campaign id for an everyday post, so
    // both shapes have to read as "not a campaign".
    function isCampaignSubmission(data) {
      return data.get('campaign', null) != null
        && data.campaign.get('id', '') is string
        && data.campaign.get('id', '') != ''
        && data.campaign.get('id', '') != 'open';
    }

    function isBlockedCreator(uid) {
      return isOwner(uid)
        && (
          request.auth.token.get('creatorStatus', '') in ['suspended', 'revoked', 'rejected']
          || (
            exists(membershipPath(uid))
            && get(membershipPath(uid)).data.status in ['suspended', 'revoked', 'rejected']
          )
        );
    }

    function publicationLicenceAllowed(licence) {
      return licence in [
        'community_restricted', 'cc_by', 'cc_by_sa', 'cc_by_nc',
        'public_domain'
      ];
    }

    function hasConsentReference(data) {
      return data.governance.consentStatus == 'granted'
        && data.governance.consent is map
        && data.governance.consent.collection == 'consentRecords'
        && data.governance.consent.id is string;
    }

    function consentIsActive(data) {
      let consent = get(/databases/$(database)/documents/consentRecords/$(data.governance.consent.id)).data;
      return consent.status == 'granted'
        && consent.subject.id == data.governance.contributor.id
        && 'publication' in consent.scope;
    }

    function consentWillBeActive(data) {
      let consent = getAfter(/databases/$(database)/documents/consentRecords/$(data.governance.consent.id)).data;
      return consent.status == 'granted'
        && consent.subject.id == data.governance.contributor.id
        && 'publication' in consent.scope;
    }

    function lifecycleIsValid(data) {
      return data.lifecycle.createdAt is string
        && data.lifecycle.updatedAt is string
        && data.lifecycle.version is int
        && data.lifecycle.version >= 1;
    }

    function validShortText(value, max) {
      return value is string && value.size() <= max;
    }

    function validTextFieldMap(fields) {
      return fields is map
        && fields.keys().hasOnly([
          'fullName', 'displayName', 'roleTitle', 'teamCompany', 'email',
          'phone', 'location', 'sitePurpose', 'audience', 'visitorAction',
          'siteName', 'tagline', 'brandColors', 'preferredStyle',
          'inspirationLinks', 'shortBio', 'services', 'projects',
          'testimonials', 'achievements', 'logoAvailable',
          'profilePhotoAvailable', 'mediaNotes', 'socialLinks', 'bookingLink',
          'paymentLink', 'portfolioLinks', 'contactFields',
          'submissionDestination', 'extraNotes', 'exclusions', 'deadline'
        ])
        && fields.keys().hasAll([
          'fullName', 'email', 'sitePurpose', 'audience', 'visitorAction',
          'siteName', 'shortBio'
        ])
        && validShortText(fields.fullName, 160)
        && validShortText(fields.displayName, 160)
        && validShortText(fields.roleTitle, 160)
        && validShortText(fields.teamCompany, 160)
        && validShortText(fields.email, 180)
        && validShortText(fields.phone, 80)
        && validShortText(fields.location, 160)
        && validShortText(fields.sitePurpose, 1600)
        && validShortText(fields.audience, 1600)
        && validShortText(fields.visitorAction, 1600)
        && validShortText(fields.siteName, 180)
        && validShortText(fields.tagline, 280)
        && validShortText(fields.brandColors, 500)
        && validShortText(fields.preferredStyle, 500)
        && validShortText(fields.inspirationLinks, 1600)
        && validShortText(fields.shortBio, 2400)
        && validShortText(fields.services, 2400)
        && validShortText(fields.projects, 2400)
        && validShortText(fields.testimonials, 2400)
        && validShortText(fields.achievements, 1600)
        && validShortText(fields.logoAvailable, 80)
        && validShortText(fields.profilePhotoAvailable, 80)
        && validShortText(fields.mediaNotes, 1600)
        && validShortText(fields.socialLinks, 1600)
        && validShortText(fields.bookingLink, 500)
        && validShortText(fields.paymentLink, 500)
        && validShortText(fields.portfolioLinks, 1600)
        && validShortText(fields.contactFields, 1200)
        && validShortText(fields.submissionDestination, 500)
        && validShortText(fields.extraNotes, 2400)
        && validShortText(fields.exclusions, 1600)
        && validShortText(fields.deadline, 160);
    }

    function validTeamSiteRequest(data) {
      return data.keys().hasOnly(['formVersion', 'status', 'submittedAt', 'fields', 'desiredPages', 'features'])
        && data.formVersion == 1
        && data.status == 'new'
        && validShortText(data.submittedAt, 40)
        && validTextFieldMap(data.fields)
        && data.fields.fullName.size() > 0
        && data.fields.email.size() > 0
        && data.fields.sitePurpose.size() > 0
        && data.fields.audience.size() > 0
        && data.fields.visitorAction.size() > 0
        && data.fields.siteName.size() > 0
        && data.fields.shortBio.size() > 0
        && data.desiredPages is list
        && data.desiredPages.size() > 0
        && data.desiredPages.size() <= 12
        && data.features is list
        && data.features.size() <= 16;
    }

    function submissionReady(data) {
      return data.governance.validationStatus == 'submitted'
        && data.governance.validator == null
        && publicationLicenceAllowed(data.governance.licence)
        && hasConsentReference(data)
        && consentWillBeActive(data)
        && lifecycleIsValid(data);
    }

    // ---- Content helpers (lexical entries, sentence pairs) ------------------
    function contentReadable(data) {
      return
        // Public, validated content is world-readable.
        (data.governance.validationStatus == 'validated'
          && data.governance.culturalPermissionTier == 'public'
          && publicationLicenceAllowed(data.governance.licence)
          && hasConsentReference(data)
          && consentIsActive(data))
        // Validators and admins can read everything, including restricted tiers.
        || isValidator()
        // Signed-in contributors can read validated community-tier content...
        || (isContributor()
          && data.governance.validationStatus == 'validated'
          && data.governance.culturalPermissionTier == 'community_only'
          && publicationLicenceAllowed(data.governance.licence)
          && hasConsentReference(data)
          && consentIsActive(data))
        // ...and their own records in any state.
        || (isContributor() && data.governance.contributor.id == request.auth.uid);
    }

    function contentCreatable() {
      return isContributor()
        && request.resource.data.governance.contributor.id == request.auth.uid
        && request.resource.data.governance.validator == null
        && lifecycleIsValid(request.resource.data)
        && (
          (request.resource.data.governance.validationStatus == 'draft'
            && request.resource.data.governance.consentStatus in ['pending', 'granted'])
          || submissionReady(request.resource.data)
        );
    }

    function contentUpdatable() {
      return isContributor()
        // Only the owner, and the owner cannot reassign ownership.
        && resource.data.governance.contributor.id == request.auth.uid
        && request.resource.data.governance.contributor.id == request.auth.uid
        // Owners may edit their own drafts / returned items and (re)submit them,
        // but may never grant validation or attach a validator.
        && resource.data.governance.validationStatus in ['draft', 'needs_changes']
        && request.resource.data.governance.validationStatus in ['draft', 'submitted']
        && request.resource.data.governance.validator == null
        && request.resource.data.lifecycle.createdAt == resource.data.lifecycle.createdAt
        && request.resource.data.lifecycle.updatedAt is string
        && request.resource.data.lifecycle.version == resource.data.lifecycle.version + 1
        && (
          request.resource.data.governance.validationStatus == 'draft'
          || submissionReady(request.resource.data)
        );
    }

    // ---- Registry entities: public read, admin-managed ---------------------
    match /communities/{communityId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /languages/{languageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /dialects/{dialectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /validators/{validatorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- Content collections ----------------------------------------------
    match /lexicalEntries/{entryId} {
      allow read: if contentReadable(resource.data);
      allow create: if request.resource.data.id == entryId && contentCreatable();
      allow update: if request.resource.data.id == entryId && contentUpdatable();
      allow delete: if false;
    }
    match /sentencePairs/{pairId} {
      allow read: if contentReadable(resource.data);
      allow create: if request.resource.data.id == pairId && contentCreatable();
      allow update: if request.resource.data.id == pairId && contentUpdatable();
      allow delete: if false;
    }

    // Legacy Project Kassena dictionary used by the mobile Collection. The app
    // deliberately queries `isPublished == true`, so drafts and approved-but-
    // not-yet-published rows remain private to staff.
    //
    // ── The one unpublished row anybody may read ──────────────────────────
    // An entry folded into another one by `mergeDictionaryEntries` is
    // unpublished and carries `mergedInto`. It stays readable because it is a
    // forwarding address: a member's saved word, a shared link and a Kawuri
    // citation all point at the id it used to have, and a reader who followed
    // one has to be told where the word went rather than shown "this entry
    // could not be loaded". The document was published — merging it is why it
    // no longer is — so nothing is disclosed that was ever private.
    //
    // Writes stay closed to every client. Editing, merging and deleting a
    // published word all run through the callables in `dictionary-admin.ts`,
    // because every rule they enforce — a headword is never blanked, a
    // homograph number is never silently reused, a deletion carries the whole
    // document into the audit log first — is a rule about the shape of the
    // archive that a Security Rule cannot express.
    match /dictionaryEntries/{entryId} {
      allow read: if resource.data.get('isPublished', false) == true
        || resource.data.get('mergedInto', null) != null
        || isStaff();
      allow write: if false;
    }

    // ---- The guided word queue ---------------------------------------------
    //
    // Fifteen thousand English words in frequency order, each waiting for a
    // Kasem translation. It exists because the dictionary form used to be a
    // blank field: asked to think of a word out of the whole language, people
    // freeze and leave. Now the app asks a specific question, with the sentence
    // the word came from, and a member can answer it or skip it.
    //
    // Open rows are world-readable so a guest browsing the dictionary can see
    // what is still unanswered — the size of the backlog is the honest state of
    // the language's coverage, not something to keep behind a login. Translated
    // and retired rows stay with staff: a row that has left the queue carries
    // review state rather than public information.
    //
    // `resource.data.status` is compared directly rather than through
    // `.get('status', 'open')` so the rule is provably satisfied by the serving
    // query, which is `where('status','==','open').orderBy('rank')`.
    //
    // No client writes, ever. `approvedCount`, `pendingCount`, `skipCount` and
    // `status` ARE the integrity of the queue — a phone that could increment
    // them could retire a word by claiming it had been translated — so they
    // belong to the callables in services/functions/src/word-queue.ts and to
    // nothing else.
    match /wordQueue/{wordId} {
      allow read: if resource.data.status == 'open' || isStaff();
      allow write: if false;
    }

    // One document per member recording which queued words they have answered
    // and which they skipped, so `nextQueueWords` can filter a batch on the
    // server before it crosses a metered connection. One document rather than
    // an edge document per word: fifteen thousand of those per member would be
    // absurd, and the two arrays are capped inside word-queue.ts, well within
    // Firestore's 1 MB per-document ceiling.
    //
    // The member reads their own so the client can show progress without a
    // round trip. Nobody writes but the Admin SDK: a client that could write
    // here could clear its own skip list, which is harmless, or write somebody
    // else's, which would silently re-offer words they had already dealt with —
    // exactly the experience the list exists to prevent.
    match /wordQueueProgress/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow write: if false;
    }

    // The idempotency ledger behind the word-queue approval trigger: one
    // document per contribution holding the counter state already applied for
    // it. It lives here rather than as a field on the contribution precisely so
    // that settling a claim does not re-fire every trigger watching
    // `collectionContributions` — contributor scoring is on that same path.
    //
    // Pure server bookkeeping with no client reader. The default-deny rule at
    // the bottom of this file would already cover it; it is written out so the
    // collection turns up when somebody greps the rules for it, rather than
    // looking like an oversight.
    match /wordQueueClaims/{contributionId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---- Grammar rules: the answers no word queue could ever collect -------
    //
    // A few dozen documents beside fifteen thousand, and they carry the
    // questions the queue could never answer. Ranks one to seven of `wordQueue`
    // are `the, of, to, and, a, in, is`, so every new contributor met them
    // first — and "what is the Kasem for *the*" has no answer, because
    // definiteness in Kasem is a property of the noun rather than a word of its
    // own. Asked fifteen thousand times, that question collects nothing; stated
    // once here as a rule, it is answered for the whole language.
    //
    // Small and closed on purpose. This is not a second crowd-sourced
    // collection: a grammatical claim about a language with few written sources
    // gets published, taught, and repeated back by Kawuri, so it is authored by
    // the project and its validators through `seed-grammar.mjs` rather than
    // submitted from a phone.
    //
    // `status` is compared directly rather than through `.get(...)` — the same
    // convention as `wordQueue` above — so the serving query
    // `where('status','==','published')` is provably satisfied by this rule.
    // Drafts stay with staff: a half-written rule about somebody's language is
    // exactly the thing that must not be read as settled.
    match /grammarRules/{ruleId} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow write: if false;
    }

    // ---- The sentence corpus, and the two queues that feed it ---------------
    //
    // `grammarRules` above says how a word behaves. These say how a clause is
    // built, which is the half a dictionary structurally cannot hold: knowing
    // every word in "the big boy is hungry" tells you nothing about the order
    // Kasem puts them in, and laying them out as English does produces a
    // sentence that is wrong while every word in it is right.
    //
    // Every one of these is `allow write: if false`, exactly like the rules
    // collection beside them. Writes go through the callables in
    // services/functions/src/grammar-contributions.ts, which is what puts a
    // validator between a contributed sentence and the corpus Kawuri quotes.

    // Confirmed sentences. World-readable once confirmed — this is the
    // archive, and it is the point of collecting it — while a submitted one
    // is visible only to the desk that has to decide on it.
    match /kasemSentences/{sentenceId} {
      allow read: if isStaff() || (resource.data.status == 'confirmed'
        && resource.data.get('projectionVersion', 0) == 2
        && (resource.data.get('expiresAtMillis', null) == null
          || resource.data.expiresAtMillis > request.time.toMillis()));
      allow write: if false;
    }

    // Source evidence, consent and reviewer identities never enter a public projection.
    match /kasemEvidence/{noteId} {
      allow read: if isAdmin();
      allow write: if false;
      match /revisions/{revision} {
        allow read: if isAdmin();
        allow write: if false;
      }
      match /reviews/{reviewId} {
        allow read: if isAdmin() || isOwner(resource.data.reviewerId);
        allow write: if false;
      }
    }
    match /kasemDatasetReleases/{releaseId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /kasemWithdrawals/{noteId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /grammarClaims/{claimId} {
      allow read: if isStaff();
      allow write: if false;
      match /versions/{version} {
        allow read: if isStaff();
        allow write: if false;
      }
    }
    match /kasemClaimReviews/{claimId} {
      allow read: if isAdmin();
      allow write: if false;
      match /events/{eventId} {
        allow read: if isAdmin() || isOwner(resource.data.reviewerId);
        allow write: if false;
      }
    }
    match /kasemModelRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // A speaker's explanation and the examples under it, waiting for review.
    // The person who sent it may follow it; nobody else but the desk sees it,
    // because an unreviewed claim about somebody's language is exactly what
    // this project refuses to publish.
    match /grammarNotes/{noteId} {
      allow read: if isStaff() || isOwner(resource.data.authUid);
      allow write: if false;
    }

    // One member marking one answer right or wrong. Readable by its author and
    // by the desk: a verdict is feedback on the model, not a public rating of
    // it, and showing whose thumbs-down it was to everybody would change what
    // people are willing to send.
    match /kawuriVerdicts/{verdictId} {
      allow read: if isStaff() || isOwner(resource.data.authUid);
      allow write: if false;
    }

    // The derived tally. World-readable and server-written, which is the whole
    // design: see the argument in contributor-scores.ts about numbers their own
    // audience can set. A member votes by writing a verdict document above;
    // what that adds up to is not something any client gets to touch.
    match /kawuriScoreboard/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Contributors: admin-managed profile, no privilege escalation -------
    //
    // The document carries workspace permissions (edit/submit/review/publish)
    // that saveExpressionAnswer enforces, public visibility, and a private half
    // with internal editorial notes. Owners used to be able to update every
    // field but roles/status/points — which let a contributor switch their own
    // permissions back on — and to read the internal notes. Both now go through
    // callables: getContributorSelf returns the profile without internal notes,
    // updateContributorSelf changes only the descriptive fields. The legacy
    // self-registration create stays, minus the fields an admin owns.
    match /contributors/{contributorId} {
      allow read: if isValidator();
      allow create: if isAdmin() || (
        isOwner(contributorId)
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && (!('points' in request.resource.data) || request.resource.data.points == 0)
        && !request.resource.data.keys().hasAny(['permissions', 'publicVisibility', 'private', 'lastStatusReason'])
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Consent records: owner may create, changes go through Functions ----
    match /consentRecords/{consentId} {
      allow read: if isValidator() || (
        isSignedIn() && resource.data.subject.id == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.id == consentId
        && request.resource.data.subject.collection == 'contributors'
        && request.resource.data.subject.id == request.auth.uid
        && request.resource.data.grantedBy.collection == 'contributors'
        && request.resource.data.grantedBy.id == request.auth.uid
        && request.resource.data.status == 'granted'
        && 'publication' in request.resource.data.scope
        && request.resource.data.effectiveFrom is string
        && lifecycleIsValid(request.resource.data);
      // Withdrawal / expiry transitions are privileged (audited) — server only.
      allow update, delete: if false;
    }

    // ---- Reviews: written by Functions when a validation decision is made ---
    match /reviews/{reviewId} {
      allow read: if isValidator();
      allow write: if false;
    }

    // ---- Audit log: append-only, server-authored, admin-readable ------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ======================================================================
    // Creator system (TribeStudio founding creators)
    // ======================================================================

    // ---- Platform configuration: public-read, admin-managed -----------------
    // Keeps dialects, categories, guidelines and the WhatsApp URL out of the
    // frontend. Guests read; only admins write.
    match /platformConfiguration/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Campaigns: public campaigns are guest-readable, admin-managed -------
    // Submission availability is derived from `status`; admins move the lifecycle
    // so submissions open with no client redeploy. The collection-contributions
    // campaign is a backend-owned routing record and may never be client-mutated,
    // including by an admin client.
    match /campaigns/{campaignId} {
      allow read: if resource.data.visibility == 'public' || isStaff();
      allow create, update: if campaignId != 'collection-contributions'
        && isAdmin()
        && request.resource.data.id == campaignId;
      allow delete: if false;
    }

    // ---- Creator profiles: self-managed public + contact fields -------------
    // Owners may edit descriptive fields; reference, status and consent history
    // are server-managed and cannot be self-set.
    match /creatorProfiles/{creatorId} {
      allow read: if isOwner(creatorId) || isStaff();
      allow create: if isAdmin() || (
        isOwner(creatorId)
        && request.resource.data.id == creatorId
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.get('status', 'waitlisted') == 'waitlisted'
        && lifecycleIsValid(request.resource.data)
      );
      allow update: if isAdmin() || (
        isOwner(creatorId)
        && !isBlockedCreator(creatorId)
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.id == resource.data.id
        && request.resource.data.get('reference', '') == resource.data.get('reference', '')
        && request.resource.data.get('status', 'waitlisted') == resource.data.get('status', 'waitlisted')
        && request.resource.data.get('consentRefs', []) == resource.data.get('consentRefs', [])
        && request.resource.data.public.get('username', '') == resource.data.public.get('username', '')
        && request.resource.data.lifecycle.version == resource.data.lifecycle.version + 1
      );
      allow delete: if isAdmin();
    }

    // ---- Creator memberships: server-owned approval and assignment records --
    // Applicants and creators may read their own standing, but cannot mutate
    // status, roles, languages, campaigns, permissions or admin decision fields.
    match /creatorMemberships/{creatorId} {
      allow read: if isOwner(creatorId) || isStaff();
      allow write: if false;
    }

    match /creatorUsernames/{username} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Creator applications: created + decided server-side ----------------
    // Registration runs through the submitCreatorApplication function (dedupe,
    // reference number, atomic profile + notification). Owners and staff read;
    // no client may write, so status transitions stay privileged.
    match /creatorApplications/{applicationId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.authUid == request.auth.uid
      );
      allow write: if false;
    }

    // ---- Submissions: owner-managed; approval is a campaign-only gate -------
    // Two routes, deliberately different:
    //
    //   * An everyday post carries no campaign. Any signed-in account that is
    //     not suspended may create and edit it, and the onSubmissionWritten
    //     trigger publishes it straight to Explore. No verification, no queue —
    //     what is asked instead is that the creator holds the rights and has
    //     consent, which they attest in the form.
    //   * A campaign entry carries a real campaign id. Those come with rewards
    //     and eligibility, so they stay restricted to approved creators and
    //     keep the reviewed publication path.
    //
    // Either way the owner may never set moderation state, approve, schedule or
    // publish: those fields are written only by the trusted backend.
    match /submissions/{submissionId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.authUid == request.auth.uid
      );
      allow create: if isSignedIn()
        && !isBlockedCreator(request.auth.uid)
        && (!isCampaignSubmission(request.resource.data) || isApprovedCreator(request.auth.uid))
        && !request.resource.data.keys().hasAny(['contributorPortal'])
        && request.resource.data.id == submissionId
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.creator.id == request.auth.uid
        && request.resource.data.status in ['DRAFT', 'SUBMITTED']
        // Nested lookup has to go one hop at a time: Map.get() takes a key,
        // not a dotted path, so the single-string form silently matched
        // nothing and let a client stamp its own publication reference on a
        // brand-new submission.
        && request.resource.data.get('moderation', {}).get('publishedContent', null) == null
        && lifecycleIsValid(request.resource.data);
      allow update: if isSignedIn()
        && !isBlockedCreator(request.auth.uid)
        && (!isCampaignSubmission(request.resource.data) || isApprovedCreator(request.auth.uid))
        && !request.resource.data.keys().hasAny(['contributorPortal'])
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == resource.data.authUid
        // An open post stays editable after it is live; a campaign entry is
        // frozen the moment it is submitted for review.
        && resource.data.status in ['DRAFT', 'NEEDS_REVISION', 'PUBLISHED']
        && (resource.data.status != 'PUBLISHED' || !isCampaignSubmission(resource.data))
        && (request.resource.data.status in ['DRAFT', 'SUBMITTED', 'RESUBMITTED', 'WITHDRAWN']
          || (resource.data.status == 'NEEDS_REVISION' && request.resource.data.status == 'NEEDS_REVISION'))
        // Moderation outcome fields are frozen to their prior values.
        && request.resource.data.get('moderation', {}) == resource.data.get('moderation', {})
        && request.resource.data.get('rewardEligible', false) == resource.data.get('rewardEligible', false)
        && request.resource.data.lifecycle.version == resource.data.lifecycle.version + 1;
      allow delete: if false;
    }

    // ---- Published content: public read of published records, server-write ---
    // The only collection the mobile app consumes. Created / mutated exclusively
    // by the trusted publication workflow.
    match /publishedContent/{contentId} {
      allow read: if resource.data.publicationStatus == 'published' || isStaff();
      allow write: if false;
    }

    // Mobile contributions for the four Collection destinations. The callable
    // submitCollectionContribution function validates consent and atomically
    // creates both this private status record and its canonical review
    // submission. No client may bypass that bridge or mutate review state.
    match /collectionContributions/{contributionId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.authUid == request.auth.uid
      );
      allow write: if false;
    }

    // AI-assisted Studio video jobs are created and advanced only by callable
    // Functions. A creator reads their own jobs in full -- including the
    // provider task id and queue URLs, which are useless without the provider
    // key the backend never hands out -- and no one else's. Anything that must
    // stay unreadable by its own owner does not belong in this document; put
    // it in a subcollection, which the default deny below already covers.
    // Kawuri media tasks: image and video generation, English transcription,
    // media analysis. Created, advanced and deleted only by callable Functions
    // running as the backend. Readable by the member who owns the task and by
    // nobody else — not staff either: these are a member's private drafts and
    // questions, not submissions awaiting review. The app subscribes to one
    // task, or queries its own with `userId == request.auth.uid`.
    match /kawuriTasks/{taskId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /studioVideoJobs/{jobId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.ownerUid == request.auth.uid
      );
      allow write: if false;
    }

    // ---- Subscriptions: the member reads what they are owed, and nothing else
    //
    // `entitlements/{uid}` is the answer to "what has this member paid for".
    // Readable by its owner so the app can draw the right tier without a round
    // trip, and writable by nobody at all: it is derived from what Google Play
    // says about a purchase token, which is a conversation a phone has no part
    // in. Everything that sets it lives in services/functions/src/subscriptions.ts.
    //
    // The purchase tokens themselves are NOT here. A token is a bearer
    // credential — anyone holding one can ask Play about the purchase — so it
    // lives only in `subscriptionPurchases`, which nobody may read.
    match /entitlements/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow write: if false;
    }

    // Play purchase tokens and the reverse map from Play's obfuscated account
    // id back to a uid. Server-only in both directions. Spelled out rather than
    // left to the default deny because what is in them is worth naming.
    match /subscriptionPurchases/{purchaseId} {
      allow read, write: if false;
    }
    match /playAccountIndex/{accountId} {
      allow read, write: if false;
    }

    // ---- Play Integrity verdicts: staff read, nobody writes -----------------
    //
    // Deliberately not readable by the member it is about. The document says
    // which security signals a device failed, and handing that to the device is
    // handing a tamper attempt its own scorecard. The app learns only what the
    // `verifyDeviceIntegrity` callable chooses to return.
    match /deviceIntegrityChecks/{uid} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---- Zero-Tap Sign-In: restore keys ------------------------------------
    //
    // Everything the Restore Credentials flow keeps, and none of it is a
    // client's to touch. `_restoreCredentials/{uid}` holds the *public* half of
    // a member's restore key — harmless to read in the abstract, which is
    // exactly why it is worth being strict about: the collection next to it
    // maps a credential id back to a uid, and a phone that could read that map
    // could enumerate accounts from credential ids it found somewhere else.
    // `_restoreCredentialChallenges` is anti-replay state whose whole value is
    // that only the server decides when a challenge is spent.
    //
    // Written and read exclusively by restore-credentials.ts through the Admin
    // SDK. Named here rather than left to the default deny because a
    // collection that authenticates people deserves to be findable in this
    // file.
    match /_restoreCredentials/{uid} {
      allow read, write: if false;
    }
    match /_restoreCredentialIndex/{credentialId} {
      allow read, write: if false;
    }
    match /_restoreCredentialChallenges/{challengeId} {
      allow read, write: if false;
    }

    // ---- Advertising campaigns: owner reads own, server writes everything ---
    //
    // A campaign is money. Its status, what it has been charged, whether it is
    // paid and what it has earned in impressions are all decided server-side,
    // so this collection is read-only to every client — including its owner.
    // Creating, editing and cancelling all go through callables in ads.ts,
    // which price the campaign themselves rather than believing a total that
    // arrived from a phone.
    match /adCampaigns/{campaignId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.ownerUid == request.auth.uid
      );
      allow write: if false;
    }

    // ---- Ad placements: the public face of a campaign that is running -------
    //
    // The projection ads.ts writes when a paid campaign is approved: headline,
    // artwork, link, and the audience it was bought for. No budget, no payment
    // state, no owner and no impression count, because a phone that renders an
    // advert has no use for any of it and everything published here is readable
    // by the whole world — signed out included, since a guest scrolling Explore
    // is part of what the advertiser paid to reach.
    //
    // `active` is the switch a pause flips. The campaign carries on existing
    // and staff can still see what it says, but it stops being servable, which
    // is the same thing as leaving the feed. Deletion is for the ends a
    // campaign never comes back from.
    match /adPlacements/{campaignId} {
      allow read: if resource.data.get('active', false) == true || isStaff();
      allow write: if false;
    }

    // ---- Notifications: owner reads own; owner may only flip `read` ----------
    match /notifications/{notificationId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.authUid == request.auth.uid
      );
      allow create: if false;
      allow update: if isSignedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'lifecycle']);
      allow delete: if false;
    }

    // ---- Creator consent ledger: server-authored, immutable -----------------
    match /creatorConsents/{consentId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.get('subject.id', '') == request.auth.uid
      );
      allow write: if false;
    }

    // ---- Support requests: owner creates, staff resolves --------------------
    match /supportRequests/{requestId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.authUid == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.get('status', 'open') == 'open';
      allow update, delete: if isStaff();
    }

    // ---- Communications: admin-managed announcements and delivery logs -------
    match /communications/{communicationId} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ---- Team site intake: public submit, staff review ----------------------
    match /teamSiteRequests/{requestId} {
      allow create: if validTeamSiteRequest(request.resource.data);
      allow read: if isStaff();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- Public form intake (Get Involved / Interests, Contact): staff review ---
    match /publicFormSubmissions/{submissionId} {
      allow read: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ---- Newsletter subscribers: staff review, admin manage -----------------
    match /newsletterSubscribers/{subscriberId} {
      allow read: if isStaff();
      allow update, delete: if isAdmin();
    }

    // ---- Payouts: restricted to finance / super-admin, server-write ---------
    // Payout detail is masked in the UI and never client-writable.
    match /payouts/{payoutId} {
      allow read: if isFinance();
      allow write: if false;
    }

    // ======================================================================
    // Community feed (mobile "Community" tab)
    // ======================================================================
    //
    // Flat, edge-document model so every client query is a single indexed read
    // and no member ever needs write access to another member's documents:
    //
    //   communityProfiles/{uid}                — public identity, owner-written
    //   communityUsernames/{username}          — handle uniqueness registry
    //   communityPosts/{postId}                — posts and replies (parentId)
    //   communityLikes/{uid}_{postId}          — like edges, owner-written
    //   communityReposts/{uid}_{postId}        — feed reshare edges
    //   communityQuotes/{uid}_{postId}         — quote-post edges
    //   communityViews/{uid}_{postId}          — unique impressions
    //   communityPollVotes/{uid}_{postId}      — immutable poll votes
    //   communityBookmarks/{uid}_{postId}      — private saves, owner-only
    //   communityFollows/{from}_{to}           — follow edges, follower-written
    //   communityReports/{reportId}            — moderation queue
    //
    // Follower / following / post totals are computed with aggregate count()
    // queries on the client, so there are no cross-user counter writes. The one
    // exception is likeCount and replyCount on a post, which are constrained
    // below to a single-step change backed by a real edge document.

    function communityOwnsEdge(edgeId, uid, otherId) {
      return edgeId == uid + '_' + otherId;
    }

    // A birthday on a community profile is a month and a day, never a year.
    //
    // Profiles are world-readable, so a full date of birth on one is the single
    // most useful field somebody impersonating a member could take off it. The
    // app asks for the two halves the community actually wants — whose day it
    // is — and there is nowhere here for the third, so a client that sent one
    // would simply be writing a field nothing reads.
    //
    // 0 means "not said", which is why the floor is 0 rather than 1. The day
    // ceiling is a flat 31: without a year there is no February to be strict
    // about, and the client already refuses 31 April.
    function validCommunityBirthday(data) {
      return data.get('birthMonth', 0) is int
        && data.get('birthMonth', 0) >= 0
        && data.get('birthMonth', 0) <= 12
        && data.get('birthDay', 0) is int
        && data.get('birthDay', 0) >= 0
        && data.get('birthDay', 0) <= 31;
    }

    function validCommunityText(value, max) {
      return value is string && value.size() <= max;
    }

    // ---- Sub-communities: helpers -------------------------------------------
    //
    // A membership row lives at communitySpaces/{slug}/memberships/{uid}. Keeping
    // the community id in the PATH is what lets these helpers work for list
    // queries too: a rule may call get() on a path built from a wildcard, but
    // not on one built from a field of the documents a query might return.
    function spacePath(communityId) {
      return /databases/$(database)/documents/communitySpaces/$(communityId);
    }

    function spaceMemberPath(communityId, uid) {
      return /databases/$(database)/documents/communitySpaces/$(communityId)/memberships/$(uid);
    }

    function isActiveSpaceMember(communityId) {
      return isSignedIn()
        && exists(spaceMemberPath(communityId, request.auth.uid))
        && get(spaceMemberPath(communityId, request.auth.uid)).data.status == 'active';
    }

    function spaceRoleIn(communityId, roles) {
      return isActiveSpaceMember(communityId)
        && get(spaceMemberPath(communityId, request.auth.uid)).data.role in roles;
    }

    function isSpaceModerator(communityId) {
      return spaceRoleIn(communityId, ['owner', 'admin', 'moderator']);
    }

    function isSpaceAdmin(communityId) {
      return spaceRoleIn(communityId, ['owner', 'admin']);
    }

    function isOpenSpace(communityId, visibility) {
      return exists(spacePath(communityId))
        && get(spacePath(communityId)).data.status == 'active'
        && get(spacePath(communityId)).data.visibility == visibility;
    }

    // The member count moves by exactly one, in the same commit as the
    // membership row that justifies it.
    function spaceCountAfter(communityId, delta) {
      return getAfter(spacePath(communityId)).data.memberCount
        == get(spacePath(communityId)).data.memberCount + delta;
    }

    // A post category is optional. "Announcement" is the one label that says
    // something is official, so on the main feed only staff may use it and
    // inside a community only its moderators.
    function validPostCategory(data, communityId) {
      return data.get('category', '') in
          ['', 'question', 'language', 'culture', 'music', 'story', 'announcement']
        && (data.get('category', '') != 'announcement'
          || isStaff()
          || (communityId != null && isSpaceModerator(communityId)));
    }

    // What a reel made in the mobile reel creator declares about itself: its
    // topic, the creator's account of what is happening, whose work it is, and
    // the contributor's right to publish it. Optional — every other post has no
    // `reel` — but when present the rights declaration is not: a reel cannot
    // reach the feed without one. Someone who says another person made the
    // media cannot also say they created it. Immutable once written: the
    // author's own update rule only lets text and editedAt change.
    //
    // Trim points, sound and captions travel on the media items instead; list
    // items cannot be inspected here, and the media list is already capped.
    function validReelDetails(data) {
      return data.get('reel', null) == null
        || (data.reel is map
          && data.reel.keys().hasOnly(['version', 'topic', 'rights', 'context',
            'originalCreator', 'sourceOrganisation', 'ownWork', 'draftId'])
          && data.reel.get('version', 1) == 1
          && data.reel.get('topic', '') in ['storytelling', 'music', 'dance',
            'traditions', 'food', 'clothing', 'craft', 'history',
            'community_life', 'other']
          && data.reel.get('rights', '') in ['created', 'permission', 'lawful_reuse']
          && validCommunityText(data.reel.get('context', ''), 1000)
          && validCommunityText(data.reel.get('originalCreator', ''), 120)
          && validCommunityText(data.reel.get('sourceOrganisation', ''), 120)
          && data.reel.get('ownWork', true) is bool
          && validCommunityText(data.reel.get('draftId', ''), 100)
          && !(data.reel.get('ownWork', true) == false
            && data.reel.rights == 'created'));
    }

    // What a post in a PUBLIC community must carry, and who may write it.
    // A post with no communityId is an ordinary main-feed post.
    function validPublicSpacePost(data) {
      return data.get('communityId', null) == null
        ? (data.get('communityVisibility', 'public') == 'public'
          && validPostCategory(data, null))
        : (data.communityId is string
          && data.get('communityVisibility', '') == 'public'
          && validCommunityText(data.get('communityName', ''), 60)
          && isOpenSpace(data.communityId, 'public')
          && isActiveSpaceMember(data.communityId)
          && validPostCategory(data, data.communityId));
    }

    function validSpaceFields(data) {
      return data.name is string
        && data.name.size() >= 3
        && data.name.size() <= 60
        && data.nameLower == data.name.lower()
        && validCommunityText(data.get('description', ''), 500)
        && data.category in ['language', 'culture', 'music', 'history', 'faith',
          'education', 'hometown', 'diaspora', 'youth', 'other']
        && validCommunityText(data.get('language', ''), 60)
        && validCommunityText(data.get('location', ''), 80)
        && (data.get('avatarUrl', null) == null || data.avatarUrl is string)
        && (data.get('coverUrl', null) == null || data.coverUrl is string)
        && data.get('rules', []) is list
        && data.get('rules', []).size() <= 10
        && data.get('searchTokens', []) is list
        && data.get('searchTokens', []).size() <= 120;
    }

    function communityLikePath(postId) {
      return /databases/$(database)/documents/communityLikes/$(request.auth.uid + '_' + postId);
    }

    function communityRepostPath(postId) {
      return /databases/$(database)/documents/communityReposts/$(request.auth.uid + '_' + postId);
    }

    function communityQuotePath(postId) {
      return /databases/$(database)/documents/communityQuotes/$(request.auth.uid + '_' + postId);
    }

    function communityViewPath(postId) {
      return /databases/$(database)/documents/communityViews/$(request.auth.uid + '_' + postId);
    }

    // A member may change likeCount by exactly one step, and only when the
    // matching like edge is created or removed in the same commit.
    function communityLikeDelta(postId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && (
          (request.resource.data.likeCount == resource.data.likeCount + 1
            && !exists(communityLikePath(postId))
            && existsAfter(communityLikePath(postId)))
          || (request.resource.data.likeCount == resource.data.likeCount - 1
            && exists(communityLikePath(postId))
            && !existsAfter(communityLikePath(postId)))
        );
    }

    // Reply totals move one step at a time. The reply document id is not known
    // to this rule, so the constraint is the single-step change itself.
    function communityReplyDelta() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && (
          request.resource.data.replyCount == resource.data.replyCount + 1
          || request.resource.data.replyCount == resource.data.replyCount - 1
        );
    }

    function communityRepostDelta(postId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repostCount'])
        && (
          (request.resource.data.repostCount == resource.data.get('repostCount', 0) + 1
            && !exists(communityRepostPath(postId))
            && existsAfter(communityRepostPath(postId)))
          || (request.resource.data.repostCount == resource.data.get('repostCount', 0) - 1
            && exists(communityRepostPath(postId))
            && !existsAfter(communityRepostPath(postId)))
        );
    }

    function communityQuoteDelta(postId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quoteCount'])
        && (
          (request.resource.data.quoteCount == resource.data.get('quoteCount', 0) + 1
            && !exists(communityQuotePath(postId))
            && existsAfter(communityQuotePath(postId)))
          || (request.resource.data.quoteCount == resource.data.get('quoteCount', 0) - 1
            && exists(communityQuotePath(postId))
            && !existsAfter(communityQuotePath(postId)))
        );
    }

    function communityViewDelta(postId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1
        && !exists(communityViewPath(postId))
        && existsAfter(communityViewPath(postId));
    }

    match /communityProfiles/{uid} {
      // Public so guests can read the feed before signing in.
      allow read: if true;
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z][a-z0-9_]{2,19}$')
        && validCommunityText(request.resource.data.displayName, 80)
        && request.resource.data.displayName.size() > 0
        && validCommunityText(request.resource.data.get('bio', ''), 300)
        && validCommunityText(request.resource.data.get('location', ''), 80)
        && validCommunityText(request.resource.data.get('dialect', ''), 80)
        && request.resource.data.get('isVerified', false) == false
        // Verification is granted, never claimed. A new profile arrives with
        // no kind and no phone behind it.
        && request.resource.data.get('verifiedKind', '') == ''
        && request.resource.data.get('phoneVerified', false) == false
        // A supporter mark is bought, not declared. It arrives only from
        // subscriptions.ts once Play has confirmed a purchase.
        && request.resource.data.get('supporterMark', '') == ''
        && validCommunityBirthday(request.resource.data);
      // Handle, uid and verification are frozen after creation. The kind is
      // staff's to give; the phone flag is the verification callable's to set,
      // and it runs with admin credentials — so neither can move on a write the
      // member makes about themselves.
      allow update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.get('isVerified', false) == resource.data.get('isVerified', false)
        && request.resource.data.get('verifiedKind', '') == resource.data.get('verifiedKind', '')
        && request.resource.data.get('phoneVerified', false) == resource.data.get('phoneVerified', false)
        && request.resource.data.get('phoneVerifiedAt', null) == resource.data.get('phoneVerifiedAt', null)
        && request.resource.data.get('supporterMark', '') == resource.data.get('supporterMark', '')
        && validCommunityText(request.resource.data.displayName, 80)
        && request.resource.data.displayName.size() > 0
        && validCommunityText(request.resource.data.get('bio', ''), 300)
        && validCommunityText(request.resource.data.get('location', ''), 80)
        && validCommunityText(request.resource.data.get('dialect', ''), 80)
        && validCommunityBirthday(request.resource.data)
      );
      allow delete: if isAdmin();
    }

    // ---- Phone verification challenges: nobody's but the server's ----------
    //
    // Holds a salted hash of the six-digit code and of the number it was sent
    // to. A client that could read this document could answer its own
    // challenge, and a client that could write one could mark itself verified —
    // so no client does either. Both callables run with admin credentials and
    // bypass these rules entirely.
    match /phoneVerifications/{uid} {
      allow read, write: if false;
    }

    // ---- Which numbers are already spoken for --------------------------------
    //
    // One document per verified number, keyed by a one-way fingerprint of it and
    // holding nothing but the uid that answered first. It is what stops one
    // phone verifying two accounts. Closed to clients for the same reason as the
    // challenges: a readable list of fingerprints is a way to ask whether a
    // given number is on the platform.
    match /verifiedPhones/{fingerprint} {
      allow read, write: if false;
    }

    match /communityUsernames/{username} {
      allow read: if true;
      // Create-only: an existing document makes the handle unavailable, which
      // is what enforces uniqueness.
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
        && validCommunityText(request.resource.data.text, 500)
        && request.resource.data.likeCount == 0
        && request.resource.data.replyCount == 0
        && request.resource.data.get('repostCount', 0) == 0
        && request.resource.data.get('quoteCount', 0) == 0
        && request.resource.data.get('viewCount', 0) == 0
        && request.resource.data.media is list
        && request.resource.data.media.size() <= 4
        && (request.resource.data.get('quotedPostId', null) == null
          || request.resource.data.quotedPostId is string)
        && (request.resource.data.get('poll', null) == null
          || (request.resource.data.poll is map
            && request.resource.data.poll.options is list
            && request.resource.data.poll.options.size() >= 2
            && request.resource.data.poll.options.size() <= 4
            && request.resource.data.poll.totalVotes == 0
            && request.resource.data.poll.endsAt is timestamp))
        && (request.resource.data.parentId == null
          || request.resource.data.parentId is string)
        && validPublicSpacePost(request.resource.data)
        && validReelDetails(request.resource.data)
        && supporterMarkIsEarned(request.resource.data);
      // The author may edit their own body text; anyone signed in may move a
      // counter by one step under the constraints above.
      allow update: if (
        isSignedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
        && validCommunityText(request.resource.data.text, 500)
      ) || (
        isSignedIn() && communityLikeDelta(postId)
      ) || (
        isSignedIn() && communityReplyDelta()
      ) || (
        isSignedIn() && communityRepostDelta(postId)
      ) || (
        isSignedIn() && communityQuoteDelta(postId)
      ) || (
        isSignedIn() && communityViewDelta(postId)
      ) || isStaff();
      // A public community's moderators may take a post out of it.
      allow delete: if isSignedIn()
        && (resource.data.authorId == request.auth.uid
          || isStaff()
          || (resource.data.get('communityId', null) is string
            && isSpaceModerator(resource.data.communityId)));
    }

    match /communityLikes/{likeId} {
      // Public so the feed can show who appreciated a post.
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && communityOwnsEdge(likeId, request.auth.uid, request.resource.data.postId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityReposts/{repostId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.reposterId == request.auth.uid
        && request.resource.data.postId is string
        && communityOwnsEdge(repostId, request.auth.uid, request.resource.data.postId)
        && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId))
        && getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.repostCount
          == get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.get('repostCount', 0) + 1;
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.reposterId == request.auth.uid
        && getAfter(/databases/$(database)/documents/communityPosts/$(resource.data.postId)).data.repostCount
          == get(/databases/$(database)/documents/communityPosts/$(resource.data.postId)).data.get('repostCount', 0) - 1;
    }

    match /communityQuotes/{quoteId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sourcePostId is string
        && request.resource.data.quotePostId is string
        && communityOwnsEdge(quoteId, request.auth.uid, request.resource.data.sourcePostId)
        && existsAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.quotePostId))
        && getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.quotePostId)).data.authorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.quotePostId)).data.quotedPostId == request.resource.data.sourcePostId
        && getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.sourcePostId)).data.quoteCount
          == get(/databases/$(database)/documents/communityPosts/$(request.resource.data.sourcePostId)).data.get('quoteCount', 0) + 1;
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/communityPosts/$(resource.data.sourcePostId)).data.quoteCount
          == get(/databases/$(database)/documents/communityPosts/$(resource.data.sourcePostId)).data.get('quoteCount', 0) - 1;
    }

    match /communityViews/{viewId} {
      // `resource == null` is the edge a member has not written yet. Without
      // this clause the client cannot ask whether it has already counted a
      // post: dereferencing a missing document errors, and the error reads as
      // a refusal, which would leave every first impression uncounted.
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.viewerId == request.auth.uid
        || get(/databases/$(database)/documents/communityPosts/$(resource.data.postId)).data.authorId == request.auth.uid
        || isStaff()
      );
      allow create: if isSignedIn()
        && request.resource.data.viewerId == request.auth.uid
        && request.resource.data.postId is string
        && communityOwnsEdge(viewId, request.auth.uid, request.resource.data.postId)
        && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId))
        && getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.viewCount
          == get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.get('viewCount', 0) + 1;
      allow update, delete: if false;
    }

    match /communityPollVotes/{voteId} {
      // See communityViews: a member must be able to read the absence of their
      // own ballot before casting it.
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.uid == request.auth.uid
        || get(/databases/$(database)/documents/communityPosts/$(resource.data.postId)).data.authorId == request.auth.uid
        || isStaff()
      );
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.optionId is string
        && communityOwnsEdge(voteId, request.auth.uid, request.resource.data.postId)
        && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId));
      allow update, delete: if false;
    }

    match /communityBookmarks/{bookmarkId} {
      // Saves are private to their owner.
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && communityOwnsEdge(bookmarkId, request.auth.uid, request.resource.data.postId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityHiddenPosts/{edgeId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && communityOwnsEdge(edgeId, request.auth.uid, request.resource.data.postId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityMutes/{edgeId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId != request.auth.uid
        && communityOwnsEdge(edgeId, request.auth.uid, request.resource.data.targetId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityBlocks/{edgeId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId != request.auth.uid
        && communityOwnsEdge(edgeId, request.auth.uid, request.resource.data.targetId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityFollows/{followId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && communityOwnsEdge(followId, request.auth.uid, request.resource.data.followingId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    // ---- Link preview cache: server-written, read by anyone who reads posts --
    //
    // One document per link somebody has shared, holding the headline, sentence
    // and picture that link's own page publishes about itself. Written only by
    // `fetchLinkPreview` (services/functions/src/link-preview.ts), which is the
    // only thing on the platform allowed to go and fetch a stranger's web page.
    //
    // Read is open because a post is: the card is metadata about a URL that is
    // already sitting in world-readable `communityPosts` text, and gating it
    // behind sign-in would mean a guest reading the feed saw a bare URL where
    // everybody else saw an article. It carries nothing about who shared the
    // link or who read it — the sharer's campaign tags are stripped before the
    // document id is even computed.
    //
    // Nobody writes but the Admin SDK. A client that could write here could put
    // any picture and any headline under any link in the community, which is a
    // near-perfect phishing surface.
    match /linkPreviews/{previewId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Community notifications: server-authored, recipient-managed --------
    // Every row is written by a Cloud Functions trigger in response to
    // something that actually happened (a like, a reply, a follow, a mention, a
    // publication). A client may never create one — an alert is a channel
    // straight to somebody's lock screen, and forging one must be impossible —
    // and may only flip `read` or remove its own rows.
    match /communityNotifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if false;
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;
    }

    // ---- Push registrations: one row per device, owned by one account -------
    // Keyed by the FCM token itself, so a token refresh replaces the old row
    // rather than accumulating dead devices, and a token can only ever be
    // claimed by the account currently holding it. Nobody may read the
    // collection: knowing another member's tokens is knowing how to reach their
    // handset.
    match /communityDevices/{token} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token == token
        // Whether message bodies may be drawn on this handset's lock screen.
        // Optional — rows written before the preference existed have no value,
        // and the fan-out reads a missing value as "yes", which is what those
        // devices were already doing.
        && request.resource.data.get('messagePreviews', true) is bool;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityReports/{reportId} {
      allow read: if isStaff();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.postId is string
        // A report names a post, or a whole community with an empty postId.
        && (request.resource.data.postId != ''
          || (request.resource.data.get('communityId', '') is string
            && request.resource.data.get('communityId', '') != ''))
        && validCommunityText(request.resource.data.reason, 300)
        && request.resource.data.get('status', 'open') == 'open';
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ======================================================================
    // Sub-communities
    // ======================================================================
    //
    //   communitySpaces/{slug}                    — the community, world-readable
    //   communitySpaces/{slug}/memberships/{uid}  — members, requests and bans
    //   communitySpaces/{slug}/posts/{postId}     — a PRIVATE community's posts
    //
    // Not `communities`: that name belongs to the cultural registry above
    // (packages/contracts), which is admin-managed and means something else.
    //
    // A public community's posts are ordinary communityPosts carrying its
    // communityId (see validPublicSpacePost). A private community's cannot be:
    // rules are not filters, so one members-only document in communityPosts
    // would make the public feed query unprovable for everybody.

    match /communitySpaces/{communityId} {
      // Discoverable, private ones included — somebody has to be able to find
      // a private community in order to ask to join it. Its posts and member
      // list are what stay private.
      allow read: if true;

      // Created together with the owner's membership row. The slug is the
      // document id, so a second community cannot be created over the first:
      // a set on an existing document is an update, which is refused below.
      allow create: if isSignedIn()
        && communityId.matches('^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$')
        && !communityId.matches('.*--.*')
        && request.resource.data.slug == communityId
        && request.resource.data.keys().hasOnly([
          'slug', 'name', 'nameLower', 'description', 'category', 'language',
          'location', 'visibility', 'ownerId', 'memberCount', 'rules', 'status',
          'searchTokens', 'avatarUrl', 'coverUrl', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.ownerId == request.auth.uid
        && exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
        && validSpaceFields(request.resource.data)
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.memberCount == 1
        && request.resource.data.status == 'active'
        && existsAfter(spaceMemberPath(communityId, request.auth.uid))
        && getAfter(spaceMemberPath(communityId, request.auth.uid)).data.role == 'owner'
        && getAfter(spaceMemberPath(communityId, request.auth.uid)).data.status == 'active';

      allow update: if (
        // Owners and admins edit the profile. Identity, ownership, visibility
        // and the count are frozen: switching a community between public and
        // private would strand every post on the wrong side of the wall.
        isSpaceAdmin(communityId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'nameLower', 'description', 'category', 'language',
          'location', 'avatarUrl', 'coverUrl', 'rules', 'searchTokens',
          'updatedAt'])
        && validSpaceFields(request.resource.data)
      ) || (
        // Joining or leaving, proven by the caller's own membership row
        // appearing or disappearing in the same commit.
        isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
        && (
          (request.resource.data.memberCount == resource.data.memberCount + 1
            && !exists(spaceMemberPath(communityId, request.auth.uid))
            && existsAfter(spaceMemberPath(communityId, request.auth.uid))
            && getAfter(spaceMemberPath(communityId, request.auth.uid)).data.status == 'active')
          || (request.resource.data.memberCount == resource.data.memberCount - 1
            && exists(spaceMemberPath(communityId, request.auth.uid))
            && get(spaceMemberPath(communityId, request.auth.uid)).data.status == 'active'
            && !existsAfter(spaceMemberPath(communityId, request.auth.uid)))
        )
      ) || (
        // Approvals and removals move somebody else's row, which this rule
        // cannot name — so the count step is trusted to moderators, and the
        // membership rules check the pair from the other side.
        isSpaceModerator(communityId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
        && (request.resource.data.memberCount == resource.data.memberCount + 1
          || request.resource.data.memberCount == resource.data.memberCount - 1)
      ) || (
        // Handing the community over. Only the owner, only to somebody already
        // an active member, and only in the commit that makes their row the
        // owner's and takes the owner role off the caller's own.
        isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'updatedAt'])
        && exists(spaceMemberPath(communityId, request.resource.data.ownerId))
        && get(spaceMemberPath(communityId, request.resource.data.ownerId)).data.status == 'active'
        && getAfter(spaceMemberPath(communityId, request.resource.data.ownerId)).data.role == 'owner'
        && getAfter(spaceMemberPath(communityId, request.auth.uid)).data.role != 'owner'
      ) || (
        // Closing it. An owner alone in their community may shut it down,
        // leaving in the same commit. The address stays taken and every link
        // to it says it is unavailable.
        isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'active'
        && resource.data.memberCount == 1
        && request.resource.data.status == 'closed'
        && request.resource.data.memberCount == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'memberCount', 'updatedAt'])
        && !existsAfter(spaceMemberPath(communityId, request.auth.uid))
      ) || isStaff();

      allow delete: if isAdmin();

      match /memberships/{memberUid} {
        // A public community's members are public. A private community's are
        // visible to its members, to the person the row belongs to, and staff.
        allow read: if (exists(spacePath(communityId))
            && get(spacePath(communityId)).data.visibility == 'public')
          || isActiveSpaceMember(communityId)
          || (isSignedIn() && memberUid == request.auth.uid)
          || isStaff();

        allow create: if isSignedIn()
          && memberUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.communityId == communityId
          && exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
          && request.resource.data.keys().hasOnly(
            ['uid', 'communityId', 'role', 'status', 'createdAt', 'updatedAt'])
          && (
            // The owner's row, written in the batch that creates the community.
            (request.resource.data.role == 'owner'
              && request.resource.data.status == 'active'
              && !exists(spacePath(communityId))
              && getAfter(spacePath(communityId)).data.ownerId == request.auth.uid)
            // Joining a public community, counted in the same commit.
            || (request.resource.data.role == 'member'
              && request.resource.data.status == 'active'
              && isOpenSpace(communityId, 'public')
              && spaceCountAfter(communityId, 1))
            // Asking to join a private one. Nothing is counted until approval.
            || (request.resource.data.role == 'member'
              && request.resource.data.status == 'pending'
              && isOpenSpace(communityId, 'private'))
          );

        allow update: if (
          // Approving a request.
          isSpaceModerator(communityId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && spaceCountAfter(communityId, 1)
        ) || (
          // Banning somebody below the moderator's own rank. An active member
          // stops being counted; a pending request never was.
          isSpaceModerator(communityId)
          && memberUid != request.auth.uid
          && request.resource.data.status == 'banned'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && (resource.data.role == 'member' || (isSpaceAdmin(communityId) && resource.data.role == 'moderator'))
          && (resource.data.status == 'pending'
            || (resource.data.status == 'active' && spaceCountAfter(communityId, -1)))
        ) || (
          // Owners and admins promote and demote, never to or from owner.
          isSpaceAdmin(communityId)
          && memberUid != request.auth.uid
          && resource.data.status == 'active'
          && resource.data.role != 'owner'
          && request.resource.data.role in ['admin', 'moderator', 'member']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
        ) || (
          // Receiving ownership: the current owner names this member as owner
          // on the community in the same commit.
          isSignedIn()
          && memberUid != request.auth.uid
          && resource.data.status == 'active'
          && resource.data.role != 'owner'
          && request.resource.data.role == 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
          && get(spacePath(communityId)).data.ownerId == request.auth.uid
          && getAfter(spacePath(communityId)).data.ownerId == memberUid
        ) || (
          // Giving it up: the outgoing owner steps down to admin in the same
          // commit that names somebody else as owner.
          isSignedIn()
          && memberUid == request.auth.uid
          && resource.data.role == 'owner'
          && request.resource.data.role == 'admin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
          && getAfter(spacePath(communityId)).data.ownerId != request.auth.uid
        ) || isStaff();

        allow delete: if (
          // Leaving, or withdrawing a request. Owners stay; a ban cannot be
          // lifted by the person it was placed on.
          isSignedIn()
          && memberUid == request.auth.uid
          && resource.data.role != 'owner'
          && (resource.data.status == 'pending'
            || (resource.data.status == 'active' && spaceCountAfter(communityId, -1)))
        ) || (
          // An owner leaves only by closing a community they are alone in —
          // see the closing branch of the community's update rule.
          isSignedIn()
          && memberUid == request.auth.uid
          && resource.data.role == 'owner'
          && getAfter(spacePath(communityId)).data.status == 'closed'
        ) || (
          // Declining a request, removing a member, or lifting a ban.
          isSpaceModerator(communityId)
          && memberUid != request.auth.uid
          && (resource.data.role == 'member' || (isSpaceAdmin(communityId) && resource.data.role in ['admin', 'moderator']))
          && (resource.data.status in ['pending', 'banned']
            || (resource.data.status == 'active' && spaceCountAfter(communityId, -1)))
        ) || isStaff();
      }

      match /posts/{postId} {
        // Members only — the whole reason these are not in communityPosts.
        allow read: if isActiveSpaceMember(communityId) || isStaff();

        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && isActiveSpaceMember(communityId)
          && isOpenSpace(communityId, 'private')
          && request.resource.data.communityId == communityId
          && request.resource.data.communityVisibility == 'private'
          && validCommunityText(request.resource.data.get('communityName', ''), 60)
          && exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
          && validCommunityText(request.resource.data.text, 500)
          && request.resource.data.likeCount == 0
          && request.resource.data.replyCount == 0
          && request.resource.data.get('repostCount', 0) == 0
          && request.resource.data.get('quoteCount', 0) == 0
          && request.resource.data.get('viewCount', 0) == 0
          && request.resource.data.media is list
          && request.resource.data.media.size() <= 4
          // A quote would copy the post into the public feed, and the poll
          // tally only reads public posts.
          && request.resource.data.get('quotedPostId', null) == null
          && request.resource.data.get('poll', null) == null
          && (request.resource.data.parentId == null
            || request.resource.data.parentId is string)
          && validPostCategory(request.resource.data, communityId)
          && validReelDetails(request.resource.data)
          && supporterMarkIsEarned(request.resource.data);

        allow update: if (
          isSignedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && validCommunityText(request.resource.data.text, 500)
        ) || (
          isActiveSpaceMember(communityId) && communityLikeDelta(postId)
        ) || (
          isActiveSpaceMember(communityId) && communityReplyDelta()
        ) || isStaff();

        allow delete: if isSignedIn()
          && (resource.data.authorId == request.auth.uid
            || isSpaceModerator(communityId)
            || isStaff());
      }
    }

    // "Which communities am I in?" is a collection-group query over every
    // community's memberships. A member may list their own rows wherever they
    // live, and nothing else through this path.
    match /{path=**}/memberships/{memberUid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- Daily prompts: staff-written, read by everybody ---------------------
    // One document per scope — `home` for the main feed or a community's slug.
    // The app falls back to a built-in invitation when there is none.
    match /communityPrompts/{scope} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ======================================================================
    // Explore reel engagement
    // ======================================================================
    //
    // Appreciations, keeps, impressions and replies on published reels. Same
    // flat, edge-keyed shape as the community feed, and for the same reason:
    // every member writes only documents they own.
    //
    //   reelLikes/{uid}_{reelId}     — appreciation edges, world-readable
    //   reelSaves/{uid}_{reelId}     — private keeps
    //   reelViews/{uid}_{reelId}     — one impression per member per reel
    //   reelComments/{commentId}     — the reply thread on a reel
    //
    // There are no counter documents. Totals are read with aggregate count()
    // queries over these edges, exactly as follower and post totals already
    // are — so no client ever needs write access to a shared number, and a
    // count cannot drift away from the edges it describes.

    function reelOwnsEdge(edgeId, uid, reelId) {
      return edgeId == uid + '_' + reelId;
    }

    match /reelLikes/{likeId} {
      // Public so a reel can show how many people appreciated it.
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reelId is string
        && reelOwnsEdge(likeId, request.auth.uid, request.resource.data.reelId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /reelSaves/{saveId} {
      // Keeps are private to their owner.
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reelId is string
        && reelOwnsEdge(saveId, request.auth.uid, request.resource.data.reelId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /reelViews/{viewId} {
      // A viewer may read their own row, and only their own.
      //
      // This does mean there is no public view total: an aggregate count over
      // a whole reel is a query these rules cannot approve, because a `list`
      // rule that depends on `resource.data` cannot be satisfied statically.
      // The client asks anyway and treats a refusal as zero — which is why
      // each of the three totals is now counted in its own request. They used
      // to share one `Future.wait`, so this refusal took the appreciations and
      // the replies down with it and every reel showed a pair of noughts.
      //
      // Making views public would mean publishing who watched what. If the
      // number is ever wanted, it belongs in a counter a trigger maintains,
      // not in a widened read.
      allow read: if isSignedIn()
        && (resource.data.viewerId == request.auth.uid || isStaff());
      // Set rather than create: the edge id makes a repeat view idempotent,
      // so scrolling back to a reel rewrites one row instead of adding one.
      allow create, update: if isSignedIn()
        && request.resource.data.viewerId == request.auth.uid
        && request.resource.data.reelId is string
        && reelOwnsEdge(viewId, request.auth.uid, request.resource.data.reelId);
      allow delete: if false;
    }

    match /reelComments/{commentId} {
      // The reply thread under a public reel is public.
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.reelId is string
        && exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid))
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 400
        && supporterMarkIsEarned(request.resource.data);
      allow update: if false;
      allow delete: if isSignedIn()
        && (resource.data.authorId == request.auth.uid || isStaff());
    }

    // ======================================================================
    // Private conversations
    // ======================================================================
    //
    //   communityChats/{a_b}                  — the thread, its stamps, unread
    //   communityChats/{a_b}/messages/{msgId} — the messages themselves
    //
    // A thread id is the two account ids in sorted order joined by an
    // underscore. That is what the create rule checks, and it is what makes a
    // pair of members unable to end up with two conversations: whichever of
    // them opens one first computes the same id.
    //
    // Both participants may write the thread document. That is wider than the
    // strict owner-only grant used elsewhere, and deliberately so: a sender has
    // to be able to raise the *other* side's unread count, and a reader has to
    // be able to clear their own. The blast radius is the two people already in
    // the conversation, and the participant list itself is frozen.

    function chatParticipants(chatId) {
      return get(/databases/$(database)/documents/communityChats/$(chatId)).data.participants;
    }

    match /communityChats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && chatId == request.resource.data.participants[0]
            + '_' + request.resource.data.participants[1];
      // Both participants may write this document — a sender has to raise the
      // other side's unread count, and a reader has to clear their own. Two
      // fields are carved out of that grant, because "the other person can
      // write here" would otherwise mean "the other person can silence you".
      //
      //   mutedBy    muting is a decision about your own alerts. Take your own
      //              uid out of the list before and the list after, and what
      //              is left must match — which is exactly "you changed only
      //              your own membership". Compared as sets because order and
      //              duplicates carry no meaning here.
      //   lastPushAt the fan-out's own debounce stamp. A client that could
      //              forge it could hold the quiet window open and stop the
      //              other person's follow-up messages from ever ringing.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.get('mutedBy', []).toSet()
            .difference([request.auth.uid].toSet())
            == resource.data.get('mutedBy', []).toSet()
                .difference([request.auth.uid].toSet())
        && !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['lastPushAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in chatParticipants(chatId);
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in chatParticipants(chatId)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        // A message is a record of what was said. It may be withdrawn by the
        // person who said it, never rewritten after the fact.
        allow update: if false;
        allow delete: if isSignedIn()
          && (resource.data.senderId == request.auth.uid || isStaff());
      }
    }

    // ======================================================================
    // LEARNING PATH
    // ======================================================================

    // ---- Lessons: public read of published lessons, admin-managed -----------
    // The Kasem path used to be a constant compiled into the app, so adding a
    // lesson meant shipping a release and every member below that version kept
    // the old unit forever. Lessons live here now and the app treats its
    // bundled set as a fallback for a first launch with no connection.
    //
    // Unpublished lessons are staff-only: a half-written question is a wrong
    // answer waiting to be taught.
    match /learnLessons/{lessonId} {
      allow read: if resource.data.get('published', false) == true || isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.questions is list
        && request.resource.data.questions.size() > 0
        && request.resource.data.questions.size() <= 20;
      allow delete: if isAdmin();
    }

    // ---- Courses and units: the outline the Learn tab is drawn from ---------
    // A course is one language (Kasem today, others later); a unit is a stretch
    // of that course with its own title, picture and place in the order.
    // Lessons join a unit by `unitOrder`, so a unit document can be created
    // before any of its lessons are written — the Learn tab then shows it as
    // "in preparation" rather than pretending it has lessons. Drafts are
    // staff-only for the same reason unpublished lessons are.
    match /learnCourses/{courseId} {
      allow read: if resource.data.get('published', false) == true || isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.get('languageName', '') is string
        && request.resource.data.get('order', 0) is int;
      allow delete: if isAdmin();
    }
    match /learnUnits/{unitId} {
      allow read: if resource.data.get('published', false) == true || isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.order is int
        && request.resource.data.order >= 1
        && request.resource.data.get('courseId', 'kasem') is string;
      allow delete: if isAdmin();
    }

    // ---- Word of the day, when somebody chose it ----------------------------
    // Keyed by the calendar date (`2026-09-14`). Without a document for today
    // the app walks the published dictionary by date, as it always has; with
    // one, an administrator has picked the word and, optionally, an approved
    // picture for it.
    match /dailyWords/{day} {
      allow read: if true;
      allow create, update: if isAdmin()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.entryId is string
        && request.resource.data.entryId.size() > 0;
      allow delete: if isAdmin();
    }

    // ---- Course illustrations: the desk's drafts and decisions --------------
    // Written only by generateLearnIllustration and reviewLearnIllustration,
    // which run Vertex AI on the server and record the prompt, model, creator,
    // time and approval state of every picture. Staff read them to review; no
    // client writes any of it, and learners never read it — they see only the
    // public URL an approval copied onto a unit, lesson or course.
    match /learnIllustrations/{illustrationId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---- Pronunciation recordings from Speak practice -----------------------
    // Written only by submitPronunciationRecording and decided only by
    // decidePronunciationRecording. The learner who recorded can follow their
    // own; staff read them to listen and decide.
    match /pronunciationRecordings/{recordingId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // ---- Learning progress: one private row per member ----------------------
    // Learning works signed out, so the device copy stays authoritative for a
    // guest; this is what makes a finished unit survive a new phone once there
    // is an account to attach it to. Nobody but the owner may read it — what
    // somebody has and has not learned is theirs.
    match /learnProgress/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.completedLessons is list
        && request.resource.data.completedLessons.size() <= 2000
        && request.resource.data.get('xp', 0) is int
        && request.resource.data.get('xp', 0) >= 0
        && request.resource.data.get('streakDays', 0) is int
        && request.resource.data.get('streakDays', 0) >= 0
        // The calendar of days somebody learned on. Kept to a year and a bit
        // by the app; bounded here so an owner-writable document cannot grow
        // without end.
        && request.resource.data.get('activeDays', []) is list
        && request.resource.data.get('activeDays', []).size() <= 800
        && request.resource.data.get('reviewCards', {}) is map
        && request.resource.data.get('reviewCards', {}).size() <= 3000;
      allow delete: if isOwner(uid);
    }

    // ---- Contributor scores: the board, and why it is not learnProgress -----
    //
    // Points for work the community accepted. Public to read because it is a
    // leaderboard; writable by nothing but the backend because a ranking built
    // on a number its owner can write is not a ranking.
    //
    // That is the whole reason this collection exists rather than a
    // `contributionPoints` field on the row above. `learnProgress` is
    // owner-writable on purpose — learning works signed out, the lesson is
    // finished on the device, and the client reconciles by taking the more
    // generous of the two copies — and every one of those properties would hand
    // the top of the board to whoever looked at their own traffic first. Rules
    // cannot make one field of a document server-only while its neighbours stay
    // owner-writable, and `LearnProgress.toFirestore` writes the whole map back,
    // so the split is the only spelling that holds.
    //
    // The identity fields are denormalised copies of the community profile, so
    // the board is one ordered query instead of fifty profile reads behind it.
    // They are refreshed by the backend whenever it touches the row, and they
    // expose nothing new: `communityProfiles` is already world-readable.
    match /contributorScores/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Contribution point awards: the idempotency ledger ------------------
    //
    // One document per contribution that has ever paid, keyed by the
    // contribution id and created inside the same transaction that moves the
    // points. Firestore triggers are at-least-once, and a redelivered approval
    // that paid twice would be undetectable afterwards — a total carries no
    // receipt of its own. This collection is that receipt, which is why no
    // client may write one and why nobody may delete one.
    //
    // Staff-readable rather than owner-readable: "why do I have 340 points" is a
    // question support will be asked, and the member already has the total.
    match /contributorPointAwards/{contributionId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ======================================================================
    // COLLECTION: APPS AND SHOP
    // ======================================================================

    // ---- App directory: public read, admin-managed --------------------------
    // Kasem apps, scripture apps and the other Indigen World releases, each a
    // link out to a store. Guest-readable because Collection is.
    match /collectionApps/{appId} {
      allow read: if resource.data.get('published', false) == true || isStaff();
      allow write: if isAdmin();
    }

    // ---- Kassena heroes: who the language belongs to -------------------------
    //
    // Admin-curated like the Apps and Shop directories beside it in Collection.
    // Nobody contributes here from the app: a claim about who somebody was is
    // not something to crowd-source in a feed, and the project answers for
    // every word of it.
    match /kasemHeroes/{heroId} {
      allow read: if resource.data.get('published', false) == true || isStaff();
      allow write: if isAdmin();
    }

    // ---- Kassena names: the list a handle can earn its ring from -------------
    //
    // Curated by the project rather than derived from the dictionary: a
    // dictionary headword is a common noun, and taking one as a handle is not
    // the same act as carrying a name your grandmother would recognise.
    match /kasemNames/{nameId} {
      allow read: if resource.data.get('published', false) == true || isStaff();
      allow write: if isAdmin();
    }

    // ---- Asking for a Kassena name to be added ------------------------------
    //
    // The curated list was always going to be missing somebody's grandmother,
    // and a member who could not find their own name had nowhere to go: the
    // claim callable checks against `kasemNames where published == true` and
    // against nothing else, so an unlisted name is simply refused. This is the
    // way in. `requestKasemName` writes the row and `decideKasemNameRequest`
    // settles it, both with the Admin SDK, which is why every client write is
    // denied here rather than merely constrained.
    //
    // That is not ceremony. The whole value of the collection is that `ascii`
    // — the folded form a handle can hold, and therefore the thing that decides
    // who wears the kente ring — is derived on the server from the name as it
    // is properly written. A phone that could write its own `ascii`, or flip
    // its own `status` to approved, could award the ring for anything at all.
    //
    // A member reads their own requests so a screen can say "you already asked
    // for this"; staff read the queue they are reviewing.
    match /kasemNameRequests/{requestId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.uid == request.auth.uid
      );
      allow write: if false;
    }

    // ---- Shop catalogue: public read, admin-managed --------------------------
    match /shopProducts/{productId} {
      allow read: if resource.data.get('published', false) == true || isStaff();
      allow write: if isAdmin();
    }

    // ---- Shop orders: a member places one, staff fulfil it ------------------
    // No payment is taken in the app. An order is a request to buy, answered by
    // a person — which is why the member may create one and then only read it,
    // and why `status` is not theirs to move.
    match /shopOrders/{orderId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.contact is string
        && request.resource.data.contact.size() > 0
        && request.resource.data.contact.size() <= 400;
      allow update: if isStaff();
      allow delete: if false;
    }

    match /contributorAccounts/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
      match /{document=**} {
        allow read: if isSignedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/contributorAccounts/$(uid)).data.status == 'active';
        allow write: if false;
      }
    }
    match /contributorTrainingPairs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Contributor workspace: settings, community pulse, payout detail ----
    function isActiveContributor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/contributorAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/contributorAccounts/$(request.auth.uid)).data.status == 'active';
    }
    // Activity visibility and notification choices. Written by
    // saveContributorSettings, which validates every value.
    match /contributorSettings/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    // Real-time "today" activity for invited contributors: counts and a display
    // name only where the contributor chose to be named (contributor-pulse.ts).
    match /contributorPulse/{entryId} {
      allow read: if isActiveContributor() || isStaff();
      allow write: if false;
    }
    match /contributorPulseTotals/{day} {
      allow read: if isActiveContributor() || isStaff();
      allow write: if false;
    }
    // The key the pulse hashes account ids with. Backend only: with it, an
    // account id would find that account's anonymous row.
    match /contributorPulseKeys/{keyId} {
      allow read, write: if false;
    }
    // Bank and MoMo details, pending one-time codes, payment requests and
    // problem reports: server-only. Contributors see their own through
    // callables, masked; finance reviewers through finance-gated callables.
    match /contributorPayoutProfiles/{uid} {
      allow read, write: if false;
    }
    match /contributorMomoChallenges/{uid} {
      allow read, write: if false;
    }
    match /contributorPaymentRequests/{requestId} {
      allow read, write: if false;
    }
    match /contributorIssues/{issueId} {
      allow read, write: if false;
    }

    // ---- Default deny -------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
