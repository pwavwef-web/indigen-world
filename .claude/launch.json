{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tribestudio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@indigen-world/tribestudio",
        "--",
        "--port",
        "5199"
      ],
      "port": 5199
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@indigen-world/website",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "website-emulators",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "VITE_USE_EMULATORS=true",
        "VITE_FIREBASE_API_KEY=demo-key",
        "VITE_FIREBASE_PROJECT_ID=demo-indigen-world",
        "VITE_FIREBASE_APP_ID=demo-app",
        "npm",
        "run",
        "dev",
        "--workspace",
        "@indigen-world/website",
        "--",
        "--port",
        "5196",
        "--strictPort"
      ],
      "port": 5196
    },
    {
      "name": "kasem-dictionary",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@indigen-world/kasena-dictionary",
        "--",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181
    },
    {
      "name": "updates-blog-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "apps/updates-blog/preview",
        "-l",
        "5182"
      ],
      "port": 5182
    },
    {
      "name": "tribestudio-emulators",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "VITE_USE_EMULATORS=true",
        "npm",
        "run",
        "dev",
        "--workspace",
        "@indigen-world/tribestudio",
        "--",
        "--port",
        "5197",
        "--strictPort"
      ],
      "port": 5197
    }
  ]
}
