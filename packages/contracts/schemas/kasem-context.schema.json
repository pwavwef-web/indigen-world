{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.indigen-world.org/v2/kasem-context.schema.json",
  "title": "kasem-context",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "specified",
        "unspecified"
      ]
    },
    "situation": {
      "type": "string",
      "maxLength": 1200
    },
    "preceding": {
      "type": "string",
      "maxLength": 1600
    },
    "intent": {
      "type": "string",
      "maxLength": 120
    },
    "register": {
      "type": "string",
      "maxLength": 120
    }
  },
  "required": [
    "status",
    "situation",
    "preceding",
    "intent",
    "register"
  ],
  "additionalProperties": false
}
