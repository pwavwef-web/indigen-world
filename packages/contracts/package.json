{
  "name": "@indigen-world/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical JSON Schemas and shared contracts for the Indigen World ecosystem.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    "./portal-contributions": {
      "types": "./portal-contributions.d.mts",
      "default": "./portal-contributions.mjs"
    },
    "./dictionary-assistance": {
      "types": "./dictionary-assistance.d.ts",
      "default": "./dictionary-assistance.mjs"
    },
    "./contributor-details": {
      "types": "./contributor-details.d.ts",
      "default": "./contributor-details.mjs"
    },
    "./kasem-spelling": {
      "types": "./kasem-spelling.d.ts",
      "default": "./kasem-spelling.mjs"
    },
    "./labs": {
      "types": "./labs.d.ts",
      "default": "./labs.mjs"
    },
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./creator-models": {
      "types": "./creator-models.d.ts"
    },
    "./schemas/*.json": "./schemas/*.json",
    "./examples/*.json": "./examples/*.json",
    "./package.json": "./package.json",
    "./content/creator-guidelines.mjs": "./content/creator-guidelines.mjs",
    "./knowledge": {
      "types": "./knowledge.d.ts",
      "default": "./knowledge.mjs"
    },
    "./knowledge-catalog.json": "./knowledge-catalog.json",
    "./correspondence": {
      "types": "./correspondence.d.ts",
      "default": "./correspondence.mjs"
    },
    "./submission-editing": {
      "types": "./submission-editing.d.ts",
      "default": "./submission-editing.mjs"
    }
  },
  "files": [
    "portal-contributions.mjs",
    "portal-contributions.d.mts",
    "dictionary-assistance.mjs",
    "dictionary-assistance.d.ts",
    "contributor-details.mjs",
    "contributor-details.d.ts",
    "kasem-spelling.mjs",
    "kasem-spelling.d.ts",
    "labs.mjs",
    "labs.d.ts",
    "index.mjs",
    "index.d.ts",
    "creator-models.d.ts",
    "content",
    "schemas",
    "examples",
    "knowledge.mjs",
    "knowledge.d.ts",
    "knowledge-catalog.json",
    "correspondence.d.ts",
    "correspondence.mjs",
    "heritage-frame.mjs",
    "submission-editing.mjs",
    "submission-editing.d.ts"
  ],
  "scripts": {
    "test": "node scripts/validate.mjs",
    "validate": "node scripts/validate.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
