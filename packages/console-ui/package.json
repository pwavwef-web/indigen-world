{
  "name": "@indigen-world/console-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared console kit for the Indigen World operator surfaces: the admin console and the TribeStudio workspace.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kit.css": "./src/kit.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/kit.css"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "^5.7.2"
  }
}
