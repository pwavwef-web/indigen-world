# Transactional email (SMTP) configuration for services/functions.
#
# Copy to `.env` (git-ignored) to override any of these at build/deploy time.
# None of the values here are secret. The SMTP *password* is a secret and lives
# in Secret Manager as SMTP_PASSWORD — never put it in this file (see below).

# --- SMTP relay (Gmail / Google Workspace defaults) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hi@indigenworld.com

# --- Sender identity and operational inbox ---
# MAIL_FROM is the address mail is sent from; MAIL_TEAM receives contact and
# "get involved" alerts. Both default to SMTP_USER when unset.
MAIL_FROM=hi@indigenworld.com
MAIL_FROM_NAME=Indigen World
MAIL_TEAM=hi@indigenworld.com

# --- Links ---
# Turns relative notification links (e.g. /studio) into absolute URLs.
STUDIO_BASE_URL=https://tribestudio.indigenworld.com

# --- Secret (do NOT set here) ---
# The Google app password for SMTP_USER.
#   Production: firebase functions:secrets:set SMTP_PASSWORD
#   Emulator:   echo 'SMTP_PASSWORD=your app password' > .secret.local

# --- SMS (Arkesel) for high-priority notifications ---
# Approved Arkesel sender ID, max 11 characters.
ARKESEL_SENDER=Indigen
# The Arkesel API key is a secret and must NOT be set here.
#   Production: firebase functions:secrets:set ARKESEL_API_KEY
#   Emulator:   echo 'ARKESEL_API_KEY=your api key' >> .secret.local

# --- Payments (Paystack) for advertising campaigns ---
# The PUBLIC key is public by design: it is what a checkout page embeds, and
# `startAdPayment` hands it to the app. Safe to keep here.
PAYSTACK_PUBLIC_KEY=pk_test_3e8ae6009e843fa9fb197ea18c239d3e1d526d71
# Where Paystack returns the payer once the hosted checkout is finished.
PAYSTACK_CALLBACK_URL=https://indigenworld.com/ads/payment-complete
# The Paystack SECRET key authorises charges and signs webhooks. It is a secret
# and must NOT be set here.
#   Production: firebase functions:secrets:set PAYSTACK_SECRET_KEY
#   Emulator:   echo 'PAYSTACK_SECRET_KEY=your secret key' >> .secret.local
#
# Webhook: point Paystack's dashboard at the deployed `paystackWebhook`
# function. It verifies the x-paystack-signature header against the secret key
# before reading a single field of the body.
