# Transactional email (SMTP) configuration for services/functions.
#
# Copy to `.env` (git-ignored) to override any of these at build/deploy time.
# None of the values here are secret. The SMTP *password* is a secret and lives
# in Secret Manager as SMTP_PASSWORD — never put it in this file (see below).

# --- SMTP relay (Gmail / Google Workspace defaults) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hi@indigenworld.com

# --- Sender identity and operational inbox ---
# MAIL_FROM is the address mail is sent from; MAIL_TEAM receives contact and
# "get involved" alerts. Both default to SMTP_USER when unset.
MAIL_FROM=hi@indigenworld.com
MAIL_FROM_NAME=Indigen World
MAIL_TEAM=hi@indigenworld.com

# --- Links ---
# Turns relative notification links (e.g. /studio) into absolute URLs.
STUDIO_BASE_URL=https://tribestudio.indigenworld.com

# --- Secret (do NOT set here) ---
# The Google app password for SMTP_USER.
#   Production: firebase functions:secrets:set SMTP_PASSWORD
#   Emulator:   echo 'SMTP_PASSWORD=your app password' > .secret.local

# --- SMS (Arkesel) for high-priority notifications ---
# Approved Arkesel sender ID, max 11 characters.
ARKESEL_SENDER=Indigen
# The Arkesel API key is a secret and must NOT be set here.
#   Production: firebase functions:secrets:set ARKESEL_API_KEY
#   Emulator:   echo 'ARKESEL_API_KEY=your api key' >> .secret.local

# --- Payments (Paystack) for advertising campaigns ---
# The PUBLIC key is public by design: it is what a checkout page embeds, and
# `startAdPayment` hands it to the app. Safe to keep here.
PAYSTACK_PUBLIC_KEY=pk_test_3e8ae6009e843fa9fb197ea18c239d3e1d526d71
# Where Paystack returns the payer once the hosted checkout is finished.
PAYSTACK_CALLBACK_URL=https://indigenworld.com/ads/payment-complete
# The Paystack SECRET key authorises charges and signs webhooks. It is a secret
# and must NOT be set here.
#   Production: firebase functions:secrets:set PAYSTACK_SECRET_KEY
#   Emulator:   echo 'PAYSTACK_SECRET_KEY=your secret key' >> .secret.local
#
# Webhook: point Paystack's dashboard at the deployed `paystackWebhook`
# function. It verifies the x-paystack-signature header against the secret key
# before reading a single field of the body.

# --- TribeStudio AI-assisted video -----------------------------------------
# Both credentials are server-only Firebase secrets. Never put either value in
# this file or any VITE_* variable.
#   firebase functions:secrets:set RUNWAYML_API_SECRET
#   firebase functions:secrets:set FAL_KEY
# Emulator-only values may be added to services/functions/.secret.local.

# --- Google Play: integrity and subscriptions -------------------------------
# The application id purchases and integrity tokens are made against. This is
# the *production flavour's* id, not the Gradle namespace: Play created the
# listing as com.indigenworld.indigen and every Play API call must name it.
# Nothing Play-related works while this is unset — both features report
# "not configured" and let the app through rather than failing closed.
ANDROID_PACKAGE_NAME=com.indigenworld.indigen

# How hard a Play Integrity verdict is applied.
#   off      – no checks at all
#   monitor  – decode, record and log the verdict; never refuse anything
#   enforce  – additionally refuse gated actions on a failing verdict
# Ship on `monitor`. Move to `enforce` only after a few weeks of verdicts have
# been looked at: plenty of legitimate handsets in Ghana are rooted, sideloaded
# or running a custom ROM, and blocking them sight-unseen is the wrong trade.
PLAY_INTEGRITY_MODE=monitor

# Optional integrity policy overrides. The defaults are in
# services/functions/src/play-integrity-policy.ts and are deliberately lenient.
#   PLAY_INTEGRITY_MIN_DEVICE_TRUST  strong | device | basic | virtual
#   PLAY_INTEGRITY_REQUIRE_LICENSED  true refuses sideloaded installs; leave
#                                    false while internal testing tracks are in
#                                    use, because those report UNLICENSED.
#   PLAY_INTEGRITY_ALLOW_VIRTUAL     false refuses Play Games for PC.
#   ANDROID_CERTIFICATE_DIGESTS      comma-separated base64url SHA-256 digests
#                                    of the signing certificate(s). Empty skips
#                                    the check — an out-of-date list here is
#                                    worse than no list.
PLAY_INTEGRITY_MIN_DEVICE_TRUST=basic
PLAY_INTEGRITY_REQUIRE_LICENSED=false
PLAY_INTEGRITY_ALLOW_VIRTUAL=true
ANDROID_CERTIFICATE_DIGESTS=

# Pub/Sub topic Play publishes real-time developer notifications to. Create it
# in this project, grant google-play-developer-notifications@system.gserviceaccount.com
# the Pub/Sub Publisher role on it, then name it in Play Console under
# Monetise → Monetisation setup. Must match the topic id exactly.
PLAY_RTDN_TOPIC=play-billing-rtdn

# No secret is needed for either feature. Both authenticate as the function's
# own runtime service account:
#   * Play Integrity  – enable playintegrity.googleapis.com on this project and
#     link the Play Console app to it.
#   * Play Developer  – enable androidpublisher.googleapis.com AND invite the
#     runtime service account into Play Console under Users and permissions
#     with "View financial data" for this app. Enabling the API alone is not
#     enough and the resulting 401 says nothing useful.
# See docs/product/play-integrity-and-billing.md.
