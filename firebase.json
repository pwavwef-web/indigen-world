{
  "functions": {
    "source": "services/functions"
  },
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "hosting": [
    {
      "site": "indigen-world",
      "public": "apps/website/dist",
      "predeploy": [
        "npm run verify:production-main",
        "npm run check:website"
      ],
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.DS_Store",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "regex": "^/((scroll-cards|culture-banner|culture-photos|guide-banner|culture-scene)\\.(js|css)|(spelling-guide|grammar-guide)(\\.html)?)$",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        },
        {
          "source": "index.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "**/index.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "404.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "sw.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "/beyond-the-reef/**/*.@(m4a|mp3|mp4|webm|webp|jpg)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800" }
          ]
        },
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            { "key": "Content-Type", "value": "application/json" },
            { "key": "Cache-Control", "value": "public, max-age=300" }
          ]
        },
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=300" }
          ]
        },
        {
          "source": "**",
          "headers": [
            { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=()" }
          ]
        }
      ],
      "redirects": [
        {
          "regex": "^/project-kasena$",
          "destination": "/project-kassena",
          "type": 301
        }
      ],
      "rewrites": [
        { "source": "/labs/**", "destination": "/labs/index.html" },
        {
          "source": "/api/public-forms",
          "function": {
            "functionId": "publicForms",
            "region": "us-central1"
          }
        },
        {
          "source": "/post/**",
          "destination": "/post/index.html"
        },
        {
          "source": "/communities/**",
          "destination": "/communities/index.html"
        }
      ]
    },
    {
      "site": "kasem-dictionary",
      "public": "apps/kasem-dictionary/dist",
      "predeploy": [
        "npm run verify:production-main",
        "npm run check:kasena-dictionary"
      ],
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "index.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "**",
          "headers": [
            { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=()" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "indigen-admin",
      "public": "apps/admin/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=()" },
            { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
            { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
            { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-9hSosDkjpu2nNe5jbVf/2BD/WmicumGqsK5ilKgSRwk=' https://apis.google.com https://www.gstatic.com https://www.google.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.run.app https://*.firebaseio.com wss://*.firebaseio.com https://*.firebasestorage.app https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.google.com; frame-src https://project-kassena-7e026.firebaseapp.com https://www.google.com https://recaptcha.google.com https://firebasestorage.googleapis.com https://storage.googleapis.com https://*.firebasestorage.app blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" }
          ]
        },
        {
          "source": "/",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "**/!(*.*)",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "tribestudio",
      "public": "apps/tribestudio/dist",
      "predeploy": [
        "npm run verify:production-main",
        "npm run build:console-ui",
        "npm run check:tribestudio"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "regex": "^/(studio(/.*)?|workspace|creators(/.*)?|contributor(/.*)?)$",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "**/index.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "sw.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "manifest.webmanifest",
          "headers": [
            { "key": "Content-Type", "value": "application/manifest+json" },
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        },
        {
          "source": "**",
          "headers": [
            { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" },
            { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/support",
          "function": { "functionId": "supportPortal", "region": "us-central1" }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
